<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Aiursoft.Kanban.ExamRunner/Aiursoft.Kanban.ExamRunner.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../src/Aiursoft.Kanban.ExamRunner/exam-config.example.json"
             Link="ExamFixtures/exam-config.example.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/Aiursoft.Kanban.ExamRunner/Scenarios/**/*.json"
             Link="ExamFixtures/Scenarios/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
