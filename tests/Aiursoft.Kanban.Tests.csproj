<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aiursoft.Kanban.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="JunitXml.TestLogger" Version="8.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.3" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Aiursoft.AgentExam.Core.Tests/**/*.cs" />
    <Compile Remove="Aiursoft.Kanban.AgentExam.Tests/**/*.cs" />
    <Compile Remove="Aiursoft.Kanban.ExamRunner.Tests/**/*.cs" />
    <Content Remove="Aiursoft.AgentExam.Core.Tests/**" />
    <Content Remove="Aiursoft.Kanban.AgentExam.Tests/**" />
    <Content Remove="Aiursoft.Kanban.ExamRunner.Tests/**" />
    <EmbeddedResource Remove="Aiursoft.AgentExam.Core.Tests/**" />
    <EmbeddedResource Remove="Aiursoft.Kanban.AgentExam.Tests/**" />
    <EmbeddedResource Remove="Aiursoft.Kanban.ExamRunner.Tests/**" />
    <None Remove="Aiursoft.AgentExam.Core.Tests/**" />
    <None Remove="Aiursoft.Kanban.AgentExam.Tests/**" />
    <None Remove="Aiursoft.Kanban.ExamRunner.Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\Aiursoft.Kanban\Aiursoft.Kanban.csproj" />
  </ItemGroup>
</Project>
