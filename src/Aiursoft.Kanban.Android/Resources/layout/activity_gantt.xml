<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gantt_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas">

  <com.google.android.material.appbar.AppBarLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/app_bar"
      app:elevation="0dp">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/gantt_toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/app_bar"
        android:minHeight="64dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/on_app_bar"
        app:subtitleTextColor="#FF94A3B8"
        app:title="Gantt chart"
        app:titleTextColor="@color/on_app_bar" />
  </com.google.android.material.appbar.AppBarLayout>

  <androidx.core.widget.NestedScrollView
      android:id="@+id/gantt_scroll"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:clipToPadding="false"
      android:fillViewport="true"
      app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
        android:id="@+id/gantt_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="36dp">

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:paddingStart="16dp"
          android:paddingEnd="16dp"
          android:text="Choose which dates define each bar. Tap a row to open the card."
          android:textColor="@color/text_secondary"
          android:textSize="14sp" />

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginStart="12dp"
          android:layout_marginTop="12dp"
          android:layout_marginEnd="12dp"
          android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/gantt_default_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Default"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/gantt_planned_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Planned"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/gantt_actual_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Actual"
            android:textAllCaps="false" />
      </LinearLayout>

      <com.google.android.material.button.MaterialButton
          android:id="@+id/gantt_export_button"
          style="@style/Widget.Material3.Button.OutlinedButton"
          android:layout_width="wrap_content"
          android:layout_height="48dp"
          android:layout_gravity="end"
          android:layout_marginTop="8dp"
          android:layout_marginEnd="12dp"
          android:text="Export PNG"
          android:textAllCaps="false" />

      <TextView
          android:id="@+id/gantt_summary"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:paddingStart="16dp"
          android:paddingTop="14dp"
          android:paddingEnd="16dp"
          android:paddingBottom="8dp"
          android:textColor="@color/text_primary"
          android:textSize="14sp"
          android:textStyle="bold" />

      <HorizontalScrollView
          android:id="@+id/gantt_horizontal_scroll"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:clipToPadding="false"
          android:overScrollMode="always"
          android:paddingStart="12dp"
          android:paddingEnd="12dp">

        <FrameLayout
            android:id="@+id/gantt_chart_host"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
      </HorizontalScrollView>

      <TextView
          android:id="@+id/gantt_missing_heading"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="22dp"
          android:paddingStart="16dp"
          android:paddingEnd="16dp"
          android:text="CARDS WITHOUT COMPLETE DATES"
          android:textColor="@color/text_secondary"
          android:textSize="12sp"
          android:textStyle="bold" />

      <LinearLayout
          android:id="@+id/gantt_missing_list"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingStart="16dp"
          android:paddingTop="6dp"
          android:paddingEnd="16dp" />
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>

  <com.google.android.material.progressindicator.CircularProgressIndicator
      android:id="@+id/gantt_progress"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:layout_gravity="center"
      android:visibility="gone"
      app:indicatorSize="48dp"
      app:trackThickness="4dp" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
