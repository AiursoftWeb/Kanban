<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/board_sharing_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas">

  <com.google.android.material.appbar.AppBarLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/app_bar"
      app:elevation="0dp">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/board_sharing_toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/app_bar"
        android:minHeight="64dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/on_app_bar"
        app:subtitleTextColor="#FF94A3B8"
        app:title="Visibility and sharing"
        app:titleTextColor="@color/on_app_bar" />
  </com.google.android.material.appbar.AppBarLayout>

  <androidx.core.widget.NestedScrollView
      android:id="@+id/board_sharing_scroll"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:clipToPadding="false"
      android:fillViewport="true"
      app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
        android:id="@+id/board_sharing_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="36dp">

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="VISIBILITY"
          android:textColor="@color/text_secondary"
          android:textSize="12sp"
          android:textStyle="bold" />

      <com.google.android.material.materialswitch.MaterialSwitch
          android:id="@+id/public_board_switch"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:minHeight="56dp"
          android:text="Allow anyone with the link to view"
          android:textColor="@color/text_primary"
          android:textSize="15sp" />

      <com.google.android.material.button.MaterialButton
          android:id="@+id/share_public_link_button"
          style="@style/Widget.Material3.Button.OutlinedButton"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:layout_marginTop="8dp"
          android:text="Share public link"
          android:textAllCaps="false"
          android:visibility="gone"
          app:cornerRadius="14dp" />

      <TextView
          android:id="@+id/add_access_label"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="28dp"
          android:text="ADD ACCESS"
          android:textColor="@color/text_secondary"
          android:textSize="12sp"
          android:textStyle="bold" />

      <Spinner
          android:id="@+id/share_target_type_spinner"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:layout_marginTop="8dp"
          android:spinnerMode="dialog" />

      <Spinner
          android:id="@+id/share_target_spinner"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:layout_marginTop="4dp"
          android:spinnerMode="dialog" />

      <Spinner
          android:id="@+id/share_permission_spinner"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:layout_marginTop="4dp"
          android:spinnerMode="dialog" />

      <com.google.android.material.button.MaterialButton
          android:id="@+id/add_share_button"
          android:layout_width="match_parent"
          android:layout_height="54dp"
          android:layout_marginTop="10dp"
          android:text="Add share"
          android:textAllCaps="false"
          app:cornerRadius="14dp" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="28dp"
          android:text="CURRENT SHARES"
          android:textColor="@color/text_secondary"
          android:textSize="12sp"
          android:textStyle="bold" />

      <LinearLayout
          android:id="@+id/current_shares_list"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:orientation="vertical" />
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>

  <com.google.android.material.progressindicator.CircularProgressIndicator
      android:id="@+id/board_sharing_progress"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:layout_gravity="center"
      android:visibility="gone"
      app:indicatorSize="48dp"
      app:trackThickness="4dp" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
