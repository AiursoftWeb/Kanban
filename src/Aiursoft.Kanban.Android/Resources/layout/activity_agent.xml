<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/agent_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas">

  <com.google.android.material.appbar.AppBarLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/app_bar"
      app:elevation="0dp">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/agent_toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/app_bar"
        android:minHeight="64dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/on_app_bar"
        app:subtitle="Ready"
        app:subtitleTextColor="#FF94A3B8"
        app:title="AI Assistant"
        app:titleTextColor="@color/on_app_bar" />
  </com.google.android.material.appbar.AppBarLayout>

  <LinearLayout
      android:id="@+id/agent_content"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      android:paddingStart="12dp"
      android:paddingTop="12dp"
      android:paddingEnd="12dp"
      android:paddingBottom="12dp"
      app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/outline"
        app:strokeWidth="1dp">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingStart="14dp"
          android:paddingTop="10dp"
          android:paddingEnd="10dp"
          android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

          <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:text="BOARD CONTEXT"
              android:textColor="@color/text_secondary"
              android:textSize="12sp"
              android:textStyle="bold" />

          <com.google.android.material.button.MaterialButton
              android:id="@+id/agent_new_chat_button"
              style="@style/Widget.Material3.Button.TextButton"
              android:layout_width="wrap_content"
              android:layout_height="42dp"
              android:text="New chat"
              android:textAllCaps="false"
              android:textColor="@color/brand_primary" />
        </LinearLayout>

        <Spinner
            android:id="@+id/agent_board_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:contentDescription="Board context" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:id="@+id/agent_message_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="8dp">

      <LinearLayout
          android:id="@+id/agent_messages"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="bottom"
          android:orientation="vertical" />
    </ScrollView>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/agent_thinking"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/brand_primary"
        app:trackColor="@color/brand_container" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/agent_file_chip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/brand_container"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="48dp"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:paddingStart="14dp"
          android:paddingEnd="6dp">

        <TextView
            android:id="@+id/agent_file_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="@color/on_brand_container"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/agent_remove_file_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Remove"
            android:textAllCaps="false"
            android:textColor="@color/on_brand_container" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="bottom"
        android:orientation="horizontal">

      <com.google.android.material.button.MaterialButton
          android:id="@+id/agent_attach_button"
          style="@style/Widget.Material3.Button.OutlinedButton"
          android:layout_width="52dp"
          android:layout_height="56dp"
          android:contentDescription="Attach Excel workbook"
          android:padding="0dp"
          android:text=""
          app:cornerRadius="14dp"
          app:icon="@drawable/ic_attach"
          app:iconGravity="textStart"
          app:iconPadding="0dp"
          app:iconTint="@color/brand_primary" />

      <com.google.android.material.textfield.TextInputLayout
          android:id="@+id/agent_input_box"
          style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:layout_weight="1"
          android:hint="Type a message..."
          app:boxCornerRadiusBottomEnd="14dp"
          app:boxCornerRadiusBottomStart="14dp"
          app:boxCornerRadiusTopEnd="14dp"
          app:boxCornerRadiusTopStart="14dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/agent_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="5"
            android:minHeight="56dp" />
      </com.google.android.material.textfield.TextInputLayout>

      <com.google.android.material.button.MaterialButton
          android:id="@+id/agent_send_button"
          android:layout_width="wrap_content"
          android:layout_height="56dp"
          android:layout_marginStart="8dp"
          android:text="Send"
          android:textAllCaps="false"
          app:cornerRadius="14dp" />
    </LinearLayout>
  </LinearLayout>

  <com.google.android.material.progressindicator.CircularProgressIndicator
      android:id="@+id/agent_progress"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:layout_gravity="center"
      android:visibility="gone"
      app:indicatorSize="48dp"
      app:trackThickness="4dp" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
