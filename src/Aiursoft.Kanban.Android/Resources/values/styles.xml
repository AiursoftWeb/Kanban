<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
    <item name="colorPrimary">@color/brand_primary</item>
    <item name="colorPrimaryContainer">@color/brand_container</item>
    <item name="colorOnPrimaryContainer">@color/on_brand_container</item>
    <item name="colorSurface">@color/surface</item>
    <item name="colorSurfaceVariant">@color/surface_variant</item>
    <item name="colorOutline">@color/outline</item>
    <item name="android:fontFamily">sans-serif</item>
    <item name="colorOnPrimary">@color/on_brand_primary</item>
    <item name="colorOnSurface">@color/text_primary</item>
    <item name="colorOnSurfaceVariant">@color/text_secondary</item>
    <item name="materialButtonStyle">@style/KanbanButton</item>
    <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
    <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
    <item name="android:statusBarColor">@color/app_bar</item>
    <item name="android:navigationBarColor">@color/surface_canvas</item>
    <item name="android:windowBackground">@color/surface_canvas</item>
  </style>
  <style name="KanbanButton" parent="Widget.Material3.Button">
    <item name="android:textAllCaps">false</item>
    <item name="cornerRadius">18dp</item>
    <item name="android:minHeight">48dp</item>
  </style>
</resources>
