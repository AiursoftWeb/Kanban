@model Aiursoft.Kanban.Models.HomeViewModels.IndexViewModel

@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/styles/site.css" xmlns="http://www.w3.org/1999/html"/>
    <link rel="stylesheet" href="~/styles/marketing.css" xmlns="http://www.w3.org/1999/html"/>
}

<vc:marketing-navbar></vc:marketing-navbar>

<section class="landing-intro text-bg-dark pt-5 pt-lg-6 pb-5 pb-lg-7">
    <div class="landing-intro-content container h-100">
        <div class="row align-items-center h-100">
            <div class="col-lg-5 mx-auto">
                <span class="badge badge-subtle-primary p-1">@Localizer["Open Source"]</span>
                <span class="badge badge-subtle-primary p-1">@Localizer["Self Hosted"]</span>
                <span class="badge badge-subtle-primary p-1">@Localizer["MIT Licence"]</span>
                <h1 id="main-slogan" class="my-4 text-white" style="font-size: 3rem;">
                    @Localizer["Aiursoft Kanban."] <span class="text-primary">@Localizer["Work Made Visible."]</span>
                </h1>
                <p class="text-lg text-white-50">@Localizer["A lightweight, self-hosted Kanban workspace for planning boards, tracking cards, assigning work, and sharing progress across your team."]</p>
                <div class="my-4 d-flex gap-2 flex-wrap">
                    <a asp-controller="Kanban" asp-action="Index" class="btn btn-primary btn-lg btn-pill">
                        <i class="align-middle" data-lucide="columns-3"></i> @Localizer["Open boards"]
                    </a>
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-primary btn-lg btn-pill">
                        <i class="align-middle" data-lucide="layout-dashboard"></i> @Localizer["Go to dashboard"]
                    </a>
                </div>
            </div>
            <div class="col-lg-7 d-none d-lg-flex mx-auto text-center">
                <div class="landing-intro-screenshot">
                    <img src="~/images/screenshot.png" alt="Aiursoft Kanban screenshot" class="img-fluid" />
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-6">
    <div class="container">
        <div class="mb-5 text-center">
            <span class="text-uppercase text-primary text-sm fw-medium mb-1 d-block">@Localizer["Workflow Management"]</span>
            <h2 class="h1">@Localizer["Everything your team needs to move work forward."]</h2>
        </div>

        <div class="row">
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="columns-3"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Board-Centered Planning"]</h4>
                        <p class="fs-lg">@Localizer["Create boards, organize columns, and move cards through clear workflow states from idea to done."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="list-checks"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Personal Task Focus"]</h4>
                        <p class="fs-lg">@Localizer["Track assignments, priorities, labels, due dates, overdue work, and active tasks from one dashboard."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="share-2"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Flexible Board Sharing"]</h4>
                        <p class="fs-lg">@Localizer["Share boards with users or roles, choose read-only or editable access, and keep private work isolated."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="tags"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Labels and Priorities"]</h4>
                        <p class="fs-lg">@Localizer["Group cards with labels, mark priority, assign owners, and surface the most important work first."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="message-square-text"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Card Discussion"]</h4>
                        <p class="fs-lg">@Localizer["Keep task context close to the work with descriptions, comments, and public board views."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="bot"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Kanban Assistant"]</h4>
                        <p class="fs-lg">@Localizer["Use the built-in assistant to read board state and help update routine project data."]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="immersive-section position-relative w-100 overflow-hidden d-flex align-items-center">
    <div class="immersive-bg">
        <div class="bg-image-wrapper">
             <a asp-controller="Dashboard" asp-action="Index">
                 <img src="~/images/template_running_in_docker.webp" alt="Kanban running in Docker" class="img-fluid object-fit-cover w-100 h-100">
             </a>
        </div>
        <div class="bg-overlay"></div>
    </div>

    <div class="container position-relative z-2 py-5">
        <div class="row">
            <div class="col-lg-6 offset-lg-6 col-md-12">
                <div class="mb-5 text-start ps-lg-4">
                    <div class="d-inline-flex align-items-center px-3 py-1 mb-3 rounded-pill border border-white-10 bg-dark-glass-sm backdrop-blur">
                        <span class="text-info me-2"><i class="fas fa-server"></i></span>
                        <span class="text-gray-300 small fw-medium text-uppercase tracking-wider">@Localizer["Self Hosted"]</span>
                    </div>
                    <h2 class="display-4 fw-bold text-white mb-3">
                        <span class="text-primary">@Localizer["Your Workflow"]</span><br>
                        @Localizer["On Your Infrastructure"]
                    </h2>
                    <p class="lead text-gray-400 fs-5">
                        @Localizer["Deploy Kanban in minutes with Docker, SQLite for small teams, or MySQL for larger installations."]
                    </p>
                </div>

                <div class="row g-3 ps-lg-4">
                    <div class="col-md-6">
                        <div class="card bg-dark-glass border-white-10 h-100 hover-lift">
                            <div class="card-body p-4">
                                <div class="icon-box-sm bg-success-subtle text-success rounded-3 me-3 mb-3">
                                    <i class="fas fa-play-circle fa-lg"></i>
                                </div>
                                <h5 class="fw-bold text-white fs-6">@Localizer["Fast Deployment"]</h5>
                                <p class="text-gray-400 mb-0 lh-sm">@Localizer["Start with the install script or a single Docker container."]</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                         <div class="card bg-dark-glass border-white-10 h-100 hover-lift">
                            <div class="card-body p-4">
                                <div class="icon-box-sm bg-info-subtle text-info rounded-3 me-3 mb-3">
                                    <i class="fas fa-database fa-lg"></i>
                                </div>
                                <h5 class="fw-bold text-white fs-6">@Localizer["Flexible Storage"]</h5>
                                <p class="text-gray-400 mb-0 lh-sm">@Localizer["Use SQLite for simple hosting or MySQL when your team grows."]</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="card bg-dark-glass border-white-10 h-100 hover-lift">
                            <div class="card-body p-4 d-flex align-items-center">
                                <div class="icon-box-sm bg-white-10 text-white rounded-3 me-3">
                                    <i class="fas fa-user-shield"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold text-white mb-1 fs-6">@Localizer["Built-in Identity"]</h5>
                                    <p class="text-gray-400 mb-0">@Localizer["Authentication, RBAC, OpenID Connect, localization, and system management are included."]</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="card bg-dark-glass border-white-10 h-100 hover-lift text-center py-2">
                            <div class="card-body p-2">
                                <i class="fas fa-lock text-warning mb-2 fs-5"></i>
                                <div class="text-gray-300 fw-bold" style="font-size: 0.75rem">@Localizer["Private"]</div>
                                <div class="text-gray-500">@Localizer["Data Control"]</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="card bg-dark-glass border-white-10 h-100 hover-lift text-center py-2">
                            <div class="card-body p-2">
                                <i class="fas fa-ship text-primary mb-2 fs-5"></i>
                                <div class="text-gray-300 fw-bold" style="font-size: 0.75rem">@Localizer["Docker"]</div>
                                <div class="text-gray-500">@Localizer["Ready"]</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-6">
    <div class="container">
        <div class="mb-5 text-center">
            <span class="text-uppercase text-primary text-sm fw-medium mb-1 d-block">@Localizer["Navigation"]</span>
            <h2 class="h1">@Localizer["Jump directly into your daily workflow."]</h2>
        </div>

        <div class="row">
            <div class="col-12 col-md-6 col-lg-3 d-flex">
                <a asp-controller="Dashboard" asp-action="Index" class="w-100 text-decoration-none text-reset">
                    <div class="d-flex align-items-start py-3">
                        <div class="landing-feature">
                            <i data-lucide="layout-dashboard"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h4 class="mt-0">@Localizer["Dashboard"]</h4>
                            <p class="fs-lg">@Localizer["Review active tasks, owned boards, shared boards, and urgent work."]</p>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-12 col-md-6 col-lg-3 d-flex">
                <a asp-controller="Kanban" asp-action="Index" class="w-100 text-decoration-none text-reset">
                    <div class="d-flex align-items-start py-3">
                        <div class="landing-feature">
                            <i data-lucide="columns-3"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h4 class="mt-0">@Localizer["Boards"]</h4>
                            <p class="fs-lg">@Localizer["Create boards, columns, cards, labels, priorities, and assignments."]</p>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-12 col-md-6 col-lg-3 d-flex">
                <a asp-controller="MyTasks" asp-action="Index" class="w-100 text-decoration-none text-reset">
                    <div class="d-flex align-items-start py-3">
                        <div class="landing-feature">
                            <i data-lucide="list-checks"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h4 class="mt-0">@Localizer["My Tasks"]</h4>
                            <p class="fs-lg">@Localizer["Filter your assigned cards by status, labels, and priority."]</p>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-12 col-md-6 col-lg-3 d-flex">
                <a asp-controller="Agent" asp-action="Index" class="w-100 text-decoration-none text-reset">
                    <div class="d-flex align-items-start py-3">
                        <div class="landing-feature">
                            <i data-lucide="bot"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h4 class="mt-0">@Localizer["Agent"]</h4>
                            <p class="fs-lg">@Localizer["Ask for board summaries and guided updates in plain language."]</p>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>

<section class="immersive-section position-relative w-100 overflow-hidden d-flex align-items-center border-top border-white-10">
    <div class="immersive-bg-right">
        <div class="bg-image-wrapper clean-wrapper">
             <a href="https://github.com/aiursoftweb/kanban" target="_blank">
                 <img src="~/images/github.webp" alt="Kanban GitHub repository" class="img-fluid object-fit-cover w-100 h-100">
             </a>
        </div>
        <div class="bg-overlay"></div>
    </div>

    <div class="container position-relative z-2 py-5">
        <div class="row">
            <div class="col-lg-6 col-md-12">
                <div class="mb-5 text-start pe-lg-4">
                    <div class="d-inline-flex align-items-center px-3 py-1 mb-3 rounded-pill border border-white-10 bg-dark-glass-sm backdrop-blur">
                        <span class="text-white me-2"><i class="fab fa-github"></i></span>
                        <span class="text-gray-300 small fw-medium text-uppercase tracking-wider">@Localizer["Free Software"]</span>
                    </div>
                    <h2 class="display-4 fw-bold text-white mb-3">
                        <span class="text-primary">@Localizer["Aiursoft Kanban"]</span><br>
                        @Localizer["is Open Source"]
                    </h2>
                    <p class="lead text-gray-400 fs-5">
                        @Localizer["No paid tiers, no hosted lock-in, and no hidden workflow limits. Run it yourself and keep ownership of your project data."]
                    </p>

                    <div class="d-flex flex-wrap gap-2 mb-4">
                        <span class="badge bg-success-subtle text-success border border-success-subtle p-2">
                            <i class="fas fa-balance-scale me-1"></i> @Localizer["MIT License"]
                        </span>
                        <span class="badge bg-info-subtle text-info border border-info-subtle p-2">
                            <i class="fas fa-store me-1"></i> @Localizer["Free for Commercial Use"]
                        </span>
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle p-2">
                            <i class="fas fa-code me-1"></i> @Localizer["Full Stack Open Source"]
                        </span>
                    </div>

                    <div class="mt-4">
                        <a href="https://github.com/aiursoftweb/kanban" target="_blank" class="btn btn-primary btn-lg btn-pill">
                            <i class="fab fa-github me-2"></i> @Localizer["View on GitHub"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-6">
    <div class="container text-center">
        <div class="row">
            <div class="col-12 col-md-10 col-lg-9 col-xl-8 mx-auto">
                <h2 class="h1 mb-3">
                    @Localizer["Ready to organize your next project?"]
                </h2>
                <a asp-controller="Kanban" asp-action="Index" class="align-middle btn btn-primary btn-pill btn-lg mt-n1">
                    <i class="fa-solid fa-table-columns"></i>
                    <span class="ms-1">@Localizer["Open boards"]</span>
                </a>
                <a asp-controller="Dashboard" asp-action="Index" class="align-middle btn btn-dark btn-pill btn-lg mt-n1">
                    <i class="fa-solid fa-gauge-high"></i>
                    <span class="ms-1">@Localizer["Go to dashboard"]</span>
                </a>
            </div>
        </div>
    </div>
</section>

<vc:marketing-footer></vc:marketing-footer>
