@model Aiursoft.Kanban.Models.AuditLogsViewModels.IndexViewModel

<h1 class="h3 mb-3">@(Model.ShowingAllUsers ? Localizer["Operation Logs"] : Localizer["My Operation Logs"])</h1>

@if (!Model.Enabled)
{
    <div class="alert alert-info">@Localizer["Operation logging is not enabled."]</div>
}
else if (Model.Logs.Count == 0)
{
    <div class="alert alert-info">@Localizer["No operation logs were found."]</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                <tr>
                    <th>@Localizer["Time"]</th>
                    @if (Model.ShowingAllUsers)
                    {
                        <th>@Localizer["User"]</th>
                    }
                    <th>@Localizer["Operation"]</th>
                    <th>@Localizer["Source"]</th>
                    <th>@Localizer["IP Address"]</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var log in Model.Logs)
                {
                    <tr>
                        <td class="text-nowrap">@log.EventTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                        @if (Model.ShowingAllUsers)
                        {
                            <td>@(string.IsNullOrWhiteSpace(log.UserName) ? log.UserId : log.UserName)</td>
                        }
                        <td>
                            <div>@log.Summary</div>
                            <small class="text-muted">@log.Action</small>
                        </td>
                        <td>@log.Source</td>
                        <td>@log.IpAddress</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <nav class="mt-3">
        <ul class="pagination">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-route-page="@(Model.Page - 1)">@Localizer["Previous"]</a>
            </li>
            <li class="page-item disabled"><span class="page-link">@Model.Page / @Model.TotalPages</span></li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-route-page="@(Model.Page + 1)">@Localizer["Next"]</a>
            </li>
        </ul>
    </nav>
}
