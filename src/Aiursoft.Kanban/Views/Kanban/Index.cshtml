                            <input type="date" id="editCardPlannedStart" class="form-control" style="border-radius:12px" disabled="@(!Model.CanEditCurrentBoard)">
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">@Localizer["Due Date"]</label>
                            <input type="date" id="editCardDueDate" class="form-control" style="border-radius:12px" disabled="@(!Model.CanEditCurrentBoard)">
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">@Localizer["Priority"]</label>
                            <select id="editCardPriority" class="form-select" style="border-radius:12px" disabled="@(!Model.CanEditCurrentBoard)">
                                <option value="0">@Localizer["Urgent"]</option>
                                <option value="1">@Localizer["High"]</option>
                                <option value="2">@Localizer["Medium"]</option>
                                <option value="3">@Localizer["Low"]</option>
                                <option value="4">@Localizer["None"]</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">@Localizer["Assignee"]</label>
                            <select id="editCardAssignee" class="form-select" style="border-radius:12px" disabled="@(!Model.CanEditCurrentBoard)">
                                <option value="">@Localizer["Unassigned"]</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">@Localizer["Labels"]</label>
                        @if (Model.CanEditCurrentBoard)
                        {
                            <div class="input-group mb-2">
                                <input type="text" id="editCardLabelInput" class="form-control" list="editCardLabelSuggestions" placeholder="@Localizer["Search or create a label"]" style="border-radius:12px 0 0 12px">
                                <button type="button" class="btn btn-outline-secondary" id="btnAddLabel" style="border-radius:0 12px 12px 0">@Localizer["Add"]</button>
                            </div>
                            <datalist id="editCardLabelSuggestions"></datalist>
                            <div class="form-text">@Localizer["Press Enter to add a label or create a new one on the fly."]</div>
                        }
                        else
                        {
                            <div class="form-text">@Localizer["Labels are read-only because you do not have edit access to this board."]</div>
                        }
                        <div id="editCardLabels" class="edit-card-labels mt-3"></div>
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label text-muted small">@Localizer["Actual Start"] <span class="text-muted fw-normal">(@Localizer["auto"])</span></label>
                            <div id="editCardActualStart" class="form-control bg-light text-muted" style="border-radius:12px;font-size:0.82rem">—</div>
                        </div>
                        <div class="col-6">
                            <label class="form-label text-muted small">@Localizer["Actual End"] <span class="text-muted fw-normal">(@Localizer["auto"])</span></label>
                            <div id="editCardActualEnd" class="form-control bg-light text-muted" style="border-radius:12px;font-size:0.82rem">—</div>
                        </div>
                    </div>
                    <div class="comments-section">
                        <label class="form-label fw-semibold mb-2">@Localizer["Comments"]</label>
                        <div id="commentsList"></div>
                        @if (Model.CanEditCurrentBoard)
                        {
                            <div class="comment-add-area">
                                <textarea id="commentInput" placeholder="@Localizer["Add a comment..."]"></textarea>
                                <button type="button" class="btn btn-primary btn-comment-submit" id="btnAddComment">@Localizer["Send"]</button>
                            </div>
                        }
                        else
                        {
                            <div class="form-text">@Localizer["Comments are read-only because you do not have edit access to this board."]</div>
                        }
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius:10px">@(Model.CanEditCurrentBoard ? Localizer["Cancel"].Value : Localizer["Close"].Value)</button>
                    @if (Model.CanEditCurrentBoard)
                    {
                        <button type="button" class="btn btn-primary px-4" id="btnUpdateCard" style="border-radius:10px">@Localizer["Save"]</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

