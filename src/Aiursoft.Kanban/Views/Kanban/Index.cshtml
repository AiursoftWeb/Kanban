@using System.Text.Json
@model Aiursoft.Kanban.Models.KanbanViewModels.IndexViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Aiursoft.Kanban.Services.FileStorage.StorageService Storage
@{
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var highlightCardId = Context.Request.Query["highlightCard"].FirstOrDefault();
}

@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/node_modules/katex/dist/katex.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/dist/kanban-board.css" asp-append-version="true" />
}

<div class="kanban-page-wrapper">
<div class="kanban-topbar container-fluid px-4 pt-4 pb-0">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="d-flex align-items-center gap-3">
            @if (Model.CurrentBoard != null)
            {
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-semibold mb-0 board-title-display" style="font-size:0.95rem">@Model.CurrentBoard.Name</span>
                    @if (Model.CanEditCurrentBoard)
                    {
                        <button class="btn-edit-board-title" title="@Localizer["Rename board"]">
                            <i class="align-middle" style="width:12px;height:12px" data-lucide="pencil"></i>
                        </button>
                    }
                </div>
                @if (!Model.CanEditCurrentBoard)
                {
                    <span class="readonly-badge">
                        <i class="align-middle" style="width:14px;height:14px" data-lucide="eye"></i>
                        @Localizer["Read-only"]
                    </span>
                }
            }
        </div>
        <div class="d-flex gap-2">
            @if (Model.CurrentBoard != null)
            {
                @if (Model.CanEditCurrentBoard)
                {
                    <button class="btn btn-primary btn-sm" id="btnAddColumn">
                        <i class="align-middle" style="width:16px;height:16px" data-lucide="plus"></i> @Localizer["Add Column"]
                    </button>
                }
                @if (Model.IsOwner)
                {
                    <a asp-action="ManageBoard" asp-route-id="@Model.CurrentBoard.Id" class="btn btn-outline-secondary btn-sm">
                        <i class="align-middle" style="width:16px;height:16px" data-lucide="settings"></i> @Localizer["Edit Board"]
                    </a>
                    <a asp-action="ManageShares" asp-route-id="@Model.CurrentBoard.Id" class="btn btn-outline-secondary btn-sm">
                        <i class="align-middle" style="width:16px;height:16px" data-lucide="share-2"></i> @Localizer["Share"]
                    </a>
                }
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="align-middle" style="width:16px;height:16px" data-lucide="arrow-left"></i> @Localizer["All Boards"]
                </a>
            }
            @if (Model.CurrentBoard == null)
            {
                <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createBoardModal">
                    <i class="align-middle" style="width:16px;height:16px" data-lucide="plus"></i> @Localizer["New Board"]
                </button>
            }
        </div>
    </div>
</div>

    @if (Model.CurrentBoard == null)
    {
        @* ── Board List View (unchanged) ── *@
        if (Model.Boards.Any())
        {
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="table-responsive">
                        <table class="table table-hover mb-0" id="boardList">
                            <thead>
                                <tr>
                                    <th style="width:30px"></th>
                                    <th>@Localizer["Name"]</th>
                                    <th>@Localizer["Columns"]</th>
                                    <th>@Localizer["Incomplete"]</th>
                                    <th>@Localizer["In Progress"]</th>
                                    <th>@Localizer["Completed"]</th>
                                    <th>@Localizer["Overdue"]</th>
                                    <th>@Localizer["Unassigned"]</th>
                                    <th>@Localizer["Created"]</th>
                                    <th>@Localizer["Actions"]</th>
                                </tr>
                            </thead>
                            <tbody id="boardListBody">
                                @foreach (var board in Model.Boards)
                                {
                                    Model.BoardSummaries.TryGetValue(board.Id, out var summary);
                                    var incomplete = summary?.TotalIncomplete ?? 0;
                                    var inProgress = summary?.TotalInProgress ?? 0;
                                    var completed = summary?.TotalCompleted ?? 0;
                                    var overdue = summary?.TotalOverdue ?? 0;
                                    var unassigned = summary?.TotalUnassigned ?? 0;
                                    <tr class="clickable-row board-row" data-href="@Url.Action("Index", new { boardId = board.Id })" data-board-id="@board.Id">
                                        <td class="drag-handle"><i class="align-middle" data-lucide="grip-vertical" style="width:16px;height:16px"></i></td>
                                        <td><strong>@board.Name</strong></td>
                                        <td><span class="badge bg-secondary">@board.Columns.Count</span></td>
                                        <td><span class="badge bg-secondary">@incomplete</span></td>
                                        <td><span class="badge bg-info">@inProgress</span></td>
                                        <td><span class="badge bg-success">@completed</span></td>
                                        <td>
                                            @if (overdue > 0)
                                            {
                                                <span class="badge bg-danger">@overdue</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            @if (unassigned > 0)
                                            {
                                                <span class="badge bg-warning text-dark">@unassigned</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td><small class="text-muted">@board.CreationTime.ToString("yyyy-MM-dd")</small></td>
                                        <td class="text-end text-nowrap">
                                            <a asp-action="Index" asp-route-boardId="@board.Id" class="btn btn-sm btn-outline-primary me-1">
                                                <i class="align-middle" data-lucide="eye"></i> @Localizer["View"]
                                            </a>
                                            <a asp-action="ManageBoard" asp-route-id="@board.Id" class="btn btn-sm btn-outline-secondary me-1">
                                                <i class="align-middle" data-lucide="settings"></i> @Localizer["Edit"]
                                            </a>
                                            <a asp-action="ManageShares" asp-route-id="@board.Id" class="btn btn-sm btn-outline-secondary me-1">
                                                <i class="align-middle" data-lucide="share-2"></i> @Localizer["Share"]
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-danger btn-delete-board-list" data-board-id="@board.Id" data-board-name="@board.Name">
                                                <i class="align-middle" data-lucide="trash-2"></i> @Localizer["Delete"]
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i data-lucide="columns-3" style="width:40px;height:40px;color:#868e96"></i>
                </div>
                <h2 class="h5 mb-2">@Localizer["No boards yet"]</h2>
                <p class="text-muted mb-4">@Localizer["Create your first Kanban board to get started."]</p>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createBoardModal">
                    <i class="align-middle" style="width:16px;height:16px" data-lucide="plus"></i> @Localizer["Create Board"]
                </button>
            </div>
        }
    }
    else
    {
        @* ── Kanban Board View (module-driven) ── *@
        <div class="kanban-filter-bar" id="kanbanFilterBar">
            <div class="kanban-filter-bar-inner">
                <input type="text" class="kanban-filter-search" id="kanbanFilterSearch" placeholder="@Localizer["Search title or description..."]" autocomplete="off">
                <div class="kanban-filter-group" id="priorityFilterGroup">
                    <span class="kanban-filter-label">@Localizer["Priority"]</span>
                    <span class="filter-chip" data-filter-type="priority" data-filter-value="0">@Localizer["Urgent"]</span>
                    <span class="filter-chip" data-filter-type="priority" data-filter-value="1">@Localizer["High"]</span>
                    <span class="filter-chip" data-filter-type="priority" data-filter-value="2">@Localizer["Medium"]</span>
                    <span class="filter-chip" data-filter-type="priority" data-filter-value="3">@Localizer["Low"]</span>
                    <span class="filter-chip" data-filter-type="priority" data-filter-value="4">@Localizer["None"]</span>
                </div>
                <div class="kanban-filter-group" id="assigneeFilterGroup">
                    <span class="kanban-filter-label">@Localizer["Assignee"]</span>
                </div>
                <span class="filter-chip filter-chip-clear hidden" id="filterClearAll" title="@Localizer["Clear all filters"]">
                    <i data-lucide="x" style="width:13px;height:13px"></i> @Localizer["Clear"]
                </span>
            </div>
        </div>
        <div class="kanban-filter-empty" id="kanbanFilterEmpty">
            <div class="kanban-filter-empty-icon">
                <i data-lucide="filter" style="width:40px;height:40px"></i>
            </div>
            <p>@Localizer["No cards match the current filters."]</p>
        </div>
        <div class="mobile-column-switcher" id="mobileColumnSwitcher">
            <button type="button" class="mobile-column-nav-btn" id="btnMobilePrevColumn" aria-label="@Localizer["Previous column"]">
                <i class="align-middle" data-lucide="chevron-left" style="width:18px;height:18px"></i>
            </button>
            <div class="mobile-column-track" id="mobileColumnTrack"></div>
            <button type="button" class="mobile-column-nav-btn" id="btnMobileNextColumn" aria-label="@Localizer["Next column"]">
                <i class="align-middle" data-lucide="chevron-right" style="width:18px;height:18px"></i>
            </button>
        </div>
        <div class="kanban-container" id="kanban-root"></div>
    }
</div>

@* ── Create Board Modal ── *@
<div class="modal fade" id="createBoardModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:16px">
            <div class="modal-header border-0 px-4 pt-4">
                <h5 class="modal-title fw-bold">@Localizer["Create New Board"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateBoard" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body px-4">
                    <label class="form-label fw-semibold">@Localizer["Board Name"]</label>
                    <input type="text" name="name" class="form-control form-control-lg" placeholder="@Localizer["My Board"]" autofocus required
                           style="border-radius:12px">
                </div>
                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius:10px">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-primary px-4" style="border-radius:10px">@Localizer["Create Board"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (Model.CurrentBoard != null && Model.CanEditCurrentBoard)
{
    @* ── Add Column Modal ── *@
    <div class="modal fade" id="addColumnModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg" style="border-radius:16px">
                <div class="modal-header border-0 px-4 pt-4">
                    <h5 class="modal-title fw-bold">@Localizer["Add Column"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body px-4">
                    <label class="form-label fw-semibold">@Localizer["Column Name"]</label>
                    <input type="text" id="columnNameInput" class="form-control form-control-lg" placeholder="@Localizer["Review"]" autofocus
                           style="border-radius:12px">
                    <div class="invalid-feedback" id="columnError"></div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius:10px">@Localizer["Cancel"]</button>
                    <button type="button" class="btn btn-primary px-4" id="btnSaveColumn" style="border-radius:10px">@Localizer["Add Column"]</button>
                </div>
            </div>
        </div>
    </div>
}

@if (Model.CurrentBoard != null)
{
    @* ── Delete Board Modal ── *@
    <div class="modal fade" id="deleteBoardConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg" style="border-radius:16px">
                <div class="modal-header border-0 px-4 pt-4">
                    <h5 class="modal-title fw-bold text-danger"><i class="align-middle me-2" data-lucide="alert-triangle"></i>@Localizer["Delete Board"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body px-4">
                    <p>@Localizer["Are you sure you want to delete"] <strong id="deleteBoardNameDisplay"></strong>?</p>
                    <p class="text-danger small"><i class="align-middle me-1" data-lucide="info" style="width:14px;height:14px"></i> @Localizer["This action permanently removes all columns and cards. This cannot be undone."]</p>
                    <div id="deleteBoardError" class="invalid-feedback d-none"></div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius:10px">@Localizer["Cancel"]</button>
                    <button type="button" class="btn btn-danger" id="btnConfirmDeleteBoard" style="border-radius:10px">@Localizer["Delete"]</button>
                </div>
            </div>
        </div>
    </div>

    @* ── Friendly Alert Modal ── *@
    <div class="modal fade" id="friendlyAlertModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg" style="border-radius:16px">
                <div class="modal-header border-0 px-4 pt-4">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="friendlyAlertTitle"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body px-4">
                    <div class="d-flex align-items-start gap-3">
                        <i class="align-middle me-2 text-danger" id="friendlyAlertIcon" data-lucide="alert-circle"></i>
                        <p class="mb-0" id="friendlyAlertMessage"></p>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button" class="btn btn-primary px-4" data-bs-dismiss="modal" style="border-radius:10px">@Localizer["OK"]</button>
                </div>
            </div>
        </div>
    </div>
}

