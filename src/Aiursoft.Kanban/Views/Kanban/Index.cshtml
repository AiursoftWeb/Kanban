@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/lucide@@0.378.0/dist/umd/lucide.min.js"></script>
    <script src="~/node_modules/markdown-it/dist/markdown-it.min.js" asp-append-version="true"></script>
    <script src="~/node_modules/dompurify/dist/purify.min.js" asp-append-version="true"></script>
    @{
        ViewData["MarkdownTheme"] = "default";
    }
    <partial name="_MarkdownReaderAssets" />
    <script type="module">
    import { initKanbanIndexPage } from '/dist/kanban-page.js';

    initKanbanIndexPage({
        csrfToken: '@token',
        boardId: @(Model.CurrentBoard?.Id ?? 0),
        boardData: @(Model.BoardData != null
            ? Html.Raw(JsonSerializer.Serialize(Model.BoardData, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }))
            : Html.Raw("null")),
        highlightCardId: @highlightCardIdValue,
        canEditCurrentBoard: @Model.CanEditCurrentBoard.ToString().ToLowerInvariant()
    });
    </script>
}
