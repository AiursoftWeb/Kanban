@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/lucide@@0.378.0/dist/umd/lucide.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@@1.15.6/Sortable.min.js"></script>
    <script src="~/node_modules/marked/lib/marked.umd.js" asp-append-version="true"></script>
    <script src="~/node_modules/dompurify/dist/purify.min.js" asp-append-version="true"></script>
    <script src="~/node_modules/katex/dist/katex.min.js" asp-append-version="true"></script>
    <script src="~/node_modules/mermaid/dist/mermaid.min.js" asp-append-version="true"></script>

    @if (Model.CurrentBoard != null && Model.BoardData != null)
    {
    <script type="module">
    import { KanbanBoard } from '/dist/kanban-board.js';

    const csrf = '@token';
    const boardId = @Model.CurrentBoard.Id;

    async function post(url, data) {
        data.__RequestVerificationToken = csrf;
        return fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(data)
        });
    }

    const board = KanbanBoard({
        container: '#kanban-root',
        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BoardData, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase })),
        highlightCardId: @(highlightCardId != null ? highlightCardId : "0"),
        callbacks: {
            onCardClicked: (id) => {
                window.location.href = `/Cards/${id}?returnBoardId=${boardId}`;
            },

            onCardCreatedQuick: async (colId, title) => {
                const resp = await post('/Kanban/CreateCard', { columnId: colId, title });
                if (resp.ok) {
                    const json = await resp.json();
                    return { cardId: json.Id };
                }
                return null;
            },

            onCardMoved: async (cardId, targetColumnId, newOrder) => {
                await post('/Kanban/MoveCard', { cardId, targetColumnId, newOrder });
            },

            onColumnReordered: async (columnId, newOrder) => {
                await post('/Kanban/MoveColumn', { columnId, newOrder });
            },

            onColumnRenamed: async (columnId, newName) => {
                await post('/Kanban/RenameColumn', { columnId, name: newName });
            },

            onColumnStatusChanged: async (columnId, newStatus) => {
                await post('/Kanban/UpdateColumnStatus', { columnId, status: newStatus });
            },

            onColumnDeleted: async (columnId) => {
                await post('/Kanban/DeleteColumn', { columnId });
                window.location.reload();
            },

            onCreateColumn: () => {
                const modal = new bootstrap.Modal(document.getElementById('addColumnModal'));
                modal.show();
            }
        }
    });

    // ── Inline handlers (not in module scope) ──

    // Add Column button
    document.getElementById('btnAddColumn')?.addEventListener('click', () => {
        const modal = new bootstrap.Modal(document.getElementById('addColumnModal'));
        modal.show();
    });

    // Board rename
    const btnEditBoard = document.querySelector('.btn-edit-board-title');
    const titleDisplay = document.querySelector('.board-title-display');
    if (btnEditBoard && titleDisplay) {
        btnEditBoard.addEventListener('click', () => {
            const currentName = titleDisplay.textContent.trim();
            const input = document.createElement('input');
            input.type = 'text';
            input.className = 'board-title-input';
            input.value = currentName;
            titleDisplay.replaceWith(input);
            input.focus();
            input.select();

            const finish = async () => {
                const newName = input.value.trim();
                if (newName && newName !== currentName) {
                    await post('/Kanban/RenameBoard', { boardId, name: newName });
                    const span = document.createElement('span');
                    span.className = 'fw-semibold mb-0 board-title-display';
                    span.style.fontSize = '0.95rem';
                    span.textContent = newName;
                    input.replaceWith(span);
                    titleDisplay = span;
                } else {
                    const span = document.createElement('span');
                    span.className = 'fw-semibold mb-0 board-title-display';
                    span.style.fontSize = '0.95rem';
                    span.textContent = currentName;
                    input.replaceWith(span);
                    titleDisplay = span;
                }
            };

            input.addEventListener('keydown', e => {
                if (e.key === 'Enter') { e.preventDefault(); finish(); }
                if (e.key === 'Escape') { input.value = currentName; input.blur(); }
            });
            input.addEventListener('blur', () => setTimeout(finish, 150));
        });
    }

    // Add Column modal save
    document.getElementById('btnSaveColumn')?.addEventListener('click', async () => {
        const input = document.getElementById('columnNameInput');
        const name = input.value.trim();
        if (!name) return;
        await post('/Kanban/CreateColumn', { boardId, name });
        window.location.reload();
    });

    // Board list drag-drop + delete
    initBoardList();

    if (typeof lucide !== 'undefined') lucide.createIcons();
    if (typeof mermaid !== 'undefined') mermaid.initialize({ startOnLoad: false, securityLevel: 'strict' });
    </script>
    }
    else
    {
    <script>
    if (typeof lucide !== 'undefined') lucide.createIcons();
    </script>
    }

    @* Board list script (runs even without board selected) *@
    <script>
    function initBoardList() {
        var csrfToken = '@token';
        var boardListBody = document.getElementById('boardListBody');
        if (boardListBody && typeof Sortable !== 'undefined') {
            new Sortable(boardListBody, {
                animation: 200,
                easing: 'cubic-bezier(0.25, 0.46, 0.45, 0.94)',
                handle: '.drag-handle',
                ghostClass: 'sortable-ghost',
                chosenClass: 'sortable-chosen',
                onEnd: function(evt) {
                    var boardId = parseInt(evt.item.dataset.boardId, 10);
                    var newOrder = evt.newIndex;
                    fetch('/Kanban/MoveBoard', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': csrfToken },
                        body: '__RequestVerificationToken=' + encodeURIComponent(csrfToken) + '&boardId=' + boardId + '&newOrder=' + newOrder
                    }).catch(function(err) { console.error('MoveBoard failed:', err); });
                }
            });
        }

        // Board delete buttons
        document.querySelectorAll('.btn-delete-board-list').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var boardId = this.dataset.boardId;
                var boardName = this.dataset.boardName;
                document.getElementById('deleteBoardNameDisplay').textContent = boardName;
                var modal = new bootstrap.Modal(document.getElementById('deleteBoardConfirmModal'));
                modal.show();
                document.getElementById('btnConfirmDeleteBoard').onclick = function() {
                    fetch('/Kanban/DeleteBoard', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': csrfToken },
                        body: '__RequestVerificationToken=' + encodeURIComponent(csrfToken) + '&boardId=' + boardId
                    }).then(function(r) {
                        if (r.ok) window.location.reload();
                    });
                };
            });
        });
    }
    if (typeof lucide !== 'undefined') lucide.createIcons();
    </script>
}
