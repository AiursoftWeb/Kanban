                    <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius:10px">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-primary px-4" style="border-radius:10px">@Localizer["Create Board"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (Model.CurrentBoard != null && Model.CanEditCurrentBoard)
