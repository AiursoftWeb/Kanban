@using Aiursoft.WebTools
@model Aiursoft.Kanban.Models.KanbanViewModels.ArchivedBoardsViewModel
@inject IViewLocalizer Localizer

@{
    var myBoards = Model.MyArchivedBoards.ToList();
    var sharedBoards = Model.SharedArchivedShares.ToList();
    var hasBoards = myBoards.Any() || sharedBoards.Any();
}

<style>
    .clickable-row { cursor: pointer; }
    .archived-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 8px;
        background-color: #6c757d;
        color: white;
        border-radius: 4px;
        font-size: 0.75rem;
    }
</style>

<div class="row mb-3">
    <div class="col-12">
        <h3><i class="align-middle" data-lucide="archive" style="width: 24px; height: 24px;"></i> @Localizer["Archived Boards"]</h3>
        <p class="text-muted">@Localizer["Boards that have been archived by their owners and are now read-only."]</p>
    </div>
</div>

@if (!hasBoards)
{
    <div class="text-center text-muted py-5">
        <i class="align-middle" data-lucide="inbox" style="width: 64px; height: 64px;"></i>
        <h5 class="mt-3">@Localizer["No archived boards"]</h5>
        <p>@Localizer["When you archive a board, it will appear here."]</p>
    </div>
}
else
{
    @* My Archived Boards *@
    @if (myBoards.Any())
    {
        <div class="row mb-4">
            <div class="col-12">
                <h5><i class="align-middle" data-lucide="user" style="width: 20px; height: 20px;"></i> @Localizer["My Archived Boards"]</h5>
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>@Localizer["Board"]</th>
                                        <th>@Localizer["Columns"]</th>
                                        <th>@Localizer["Incomplete"]</th>
                                        <th>@Localizer["In Progress"]</th>
                                        <th>@Localizer["Completed"]</th>
                                        <th>@Localizer["Overdue"]</th>
                                        <th>@Localizer["Unassigned"]</th>
                                        <th>@Localizer["Archived At"]</th>
                                        <th class="text-end">@Localizer["Actions"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var board in myBoards)
                                    {
                                        Model.BoardSummaries.TryGetValue(board.Id, out var summary);
                                        var incomplete = summary?.TotalIncomplete ?? 0;
                                        var inProgress = summary?.TotalInProgress ?? 0;
                                        var completed = summary?.TotalCompleted ?? 0;
                                        var overdue = summary?.TotalOverdue ?? 0;
                                        var unassigned = summary?.TotalUnassigned ?? 0;
                                        <tr class="clickable-row board-row" data-href="@Url.Action("Index", "Kanban", new { boardId = board.Id })">
                                            <td>
                                                <span class="archived-badge"><i class="align-middle" data-lucide="archive"></i> @Localizer["Archived"]</span>
                                                <strong>@board.Name</strong>
                                            </td>
                                            <td><span class="badge bg-secondary">@board.Columns.Count</span></td>
                                            <td><span class="badge bg-secondary">@incomplete</span></td>
                                            <td><span class="badge bg-info">@inProgress</span></td>
                                    <td><span class="badge bg-success">@completed</span></td>
                                            <td>
                                            @if (overdue > 0)
                                            {
                                                <span class="badge bg-danger">@overdue</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            @if (unassigned > 0)
                                            {
                                                <span class="badge bg-warning text-dark">@unassigned</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td><small class="text-muted"><label data-utc-time="@board.ArchivedTime?.ToHtmlDateTime()"></label></small></td>
                                        <td class="text-end text-nowrap">
                                            <a asp-controller="Kanban" asp-action="Index" asp-route-boardId="@board.Id" class="btn btn-sm btn-outline-primary me-1">
                                                <i class="align-middle" data-lucide="eye"></i> @Localizer["View"]
                                            </a>
                                            <form asp-action="ArchiveBoard" asp-controller="Kanban" method="post" style="display:inline;">
                                                <input type="hidden" name="boardId" value="@board.Id" />
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-success" onclick="return confirm('@Localizer["Unarchive this board?"]')">
                                                    <i class="align-middle" data-lucide="rotate-ccw"></i> @Localizer["Unarchive"]
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @* Shared Archived Boards *@
    @if (sharedBoards.Any())
    {
        <div class="row mb-4">
            <div class="col-12">
                <h5><i class="align-middle" data-lucide="share-2" style="width: 20px; height: 20px;"></i> @Localizer["Shared Archived Boards"]</h5>
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>@Localizer["Board"]</th>
                                        <th>@Localizer["Shared Via"]</th>
                                        <th>@Localizer["Columns"]</th>
                                        <th>@Localizer["Incomplete"]</th>
                                        <th>@Localizer["In Progress"]</th>
                                        <th>@Localizer["Completed"]</th>
                                        <th>@Localizer["Overdue"]</th>
                                        <th>@Localizer["Unassigned"]</th>
                                        <th>@Localizer["Archived At"]</th>
                                        <th class="text-end">@Localizer["Actions"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var share in sharedBoards)
                                    {
                                        var board = share.Board;
                                        Model.BoardSummaries.TryGetValue(board.Id, out var summary);
                                        var incomplete = summary?.TotalIncomplete ?? 0;
                                        var inProgress = summary?.TotalInProgress ?? 0;
                                        var completed = summary?.TotalCompleted ?? 0;
                                        var overdue = summary?.TotalOverdue ?? 0;
                                        var unassigned = summary?.TotalUnassigned ?? 0;
                                        <tr class="clickable-row board-row" data-href="@Url.Action("View", "PublicKanban", new { boardId = board.Id })">
                                            <td>
                                                <span class="archived-badge"><i class="align-middle" data-lucide="archive"></i> @Localizer["Archived"]</span>
                                                <strong>@board.Name</strong>
                                            </td>
                                            <td>
                                                @if (share.SharedWithUserId != null)
                                                {
                                                    <span class="badge bg-info"><i class="align-middle" data-lucide="user"></i> @Localizer["Direct Share"]</span>
                                                }
                                                else if (share.SharedWithRoleId != null)
                                                {
                                                    var roleName = Model.RoleNames.GetValueOrDefault(share.SharedWithRoleId, share.SharedWithRoleId);
                                                    <div>
                                                        <span class="badge bg-primary"><i class="align-middle" data-lucide="users"></i> @Localizer["Via Role"]</span>
                                                        <small class="text-muted d-block">@roleName</small>
                                                    </div>
                                                }
                                            </td>
                                            <td><span class="badge bg-secondary">@board.Columns.Count</span></td>
                                            <td><span class="badge bg-secondary">@incomplete</span></td>
                                            <td><span class="badge bg-info">@inProgress</span></td>
                                            <td><span class="badge bg-success">@completed</span></td>
                                            <td>
                                                @if (overdue > 0)
                                                {
                                                    <span class="badge bg-danger">@overdue</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                            <td>
                                                @if (unassigned > 0)
                                                {
                                                    <span class="badge bg-warning text-dark">@unassigned</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                            <td><small class="text-muted"><label data-utc-time="@board.ArchivedTime?.ToHtmlDateTime()"></label></small></td>
                                            <td class="text-end">
                                                <a asp-controller="PublicKanban" asp-action="View" asp-route-boardId="@board.Id" class="btn btn-sm btn-outline-primary">
                                                    <i class="align-middle" data-lucide="eye"></i> @Localizer["View"]
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.clickable-row').forEach(row => {
                row.addEventListener('click', (e) => {
                    // ignore clicks on buttons or links inside the row
                    if (e.target.closest('a') || e.target.closest('button') || e.target.closest('form')) return;
                    const href = row.getAttribute('data-href');
                    if (href) window.location.href = href;
                });
            });
        });
    </script>
}