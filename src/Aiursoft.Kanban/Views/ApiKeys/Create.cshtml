@model Aiursoft.Kanban.Models.ApiKeysViewModels.CreateViewModel

<div class="container-fluid p-0">
    <h1 class="h3 mb-3">@Localizer["Create New API Key"]</h1>
    <div class="row">
        <div class="col-md-6 col-lg-4">
            <div class="card">
                <div class="card-header"><h5 class="card-title mb-0">@Localizer["New Key Details"]</h5></div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">@Localizer["Friendly Name"]</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                            <div class="form-text">@Localizer["A name to help you identify where this key is used."]</div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ExpirationDays" class="form-label">@Localizer["Validity (days)"]</label>
                            <input asp-for="ExpirationDays" class="form-control" type="number" min="1"
                                   max="@Aiursoft.Kanban.Models.ApiKeysViewModels.CreateViewModel.MaximumExpirationDays" />
                            <span asp-validation-for="ExpirationDays" class="text-danger"></span>
                            <div class="form-text">@Localizer["Validity cannot exceed 15 years."]</div>
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">@Localizer["Generate Key"]</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
