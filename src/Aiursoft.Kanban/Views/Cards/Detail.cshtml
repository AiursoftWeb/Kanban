@using System.Text.Json
@using Aiursoft.WebTools
@model Aiursoft.Kanban.Models.CardViewModels.CardDetailViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Aiursoft.Kanban.Services.FileStorage.StorageService StorageService
@{
    var isDarkMode = Context.Request.Cookies["prefer-dark"] == true.ToString();
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var returnBoardUrl = Url.Action("Index", "Kanban", new { boardId = Model.ReturnBoardId }) ?? "/Kanban";
    var backToBoardUrl = Url.Action("Index", "Kanban", new { boardId = Model.ReturnBoardId, highlightCard = Model.CardId }) ?? returnBoardUrl;
    var kanbanImageUploadUrl = StorageService.GetUploadUrl("kanban-images");
}

@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/node_modules/@@fontsource/cascadia-code/index.css" asp-append-version="true" />
    @if (isDarkMode)
    {
        <link rel="stylesheet" href="~/node_modules/@@highlightjs/cdn-assets/styles/github-dark.min.css" asp-append-version="true" />
    }
    else
    {
        <link rel="stylesheet" href="~/node_modules/@@highlightjs/cdn-assets/styles/github.min.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/dist/kanban-board.css" asp-append-version="true" />
    <style>
        .card-detail-shell {
            max-width: 1180px;
        }

        .card-detail-hero {
            border: 1px solid rgba(148, 163, 184, 0.18);
            border-radius: 28px;
            padding: 1.5rem;
            background:
                radial-gradient(circle at top left, rgba(59, 130, 246, 0.12), transparent 36%),
                radial-gradient(circle at top right, rgba(139, 92, 246, 0.12), transparent 30%),
                linear-gradient(180deg, rgba(255,255,255,0.96), rgba(248,250,252,0.94));
            box-shadow: 0 22px 48px rgba(15, 23, 42, 0.08);
        }

        .detail-surface {
            border: 1px solid rgba(148, 163, 184, 0.18);
            border-radius: 24px;
            background: rgba(255,255,255,0.96);
            box-shadow: 0 12px 28px rgba(15, 23, 42, 0.05);
            overflow: hidden;
        }

        .detail-surface-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 1.1rem 1.35rem 0;
        }

        .detail-surface-body {
            padding: 1rem 1.35rem 1.35rem;
        }

        .detail-meta-chip {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 0.4rem 0.75rem;
            border-radius: 999px;
            background: rgba(241, 245, 249, 0.92);
            color: #334155;
            font-size: 0.8rem;
            font-weight: 600;
            border: 1px solid rgba(148, 163, 184, 0.18);
        }

        .detail-meta-chip i {
            color: #64748b;
        }

        .detail-kv {
            display: grid;
            grid-template-columns: 92px 1fr;
            gap: 0.7rem;
            align-items: center;
            margin-bottom: 0.85rem;
        }

        .detail-kv:last-child {
            margin-bottom: 0;
        }

        .detail-kv-label {
            font-size: 0.78rem;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .detail-kv-value {
            min-width: 0;
        }

        .detail-stat-box {
            border-radius: 16px;
            background: linear-gradient(180deg, rgba(248,250,252,0.94), rgba(241,245,249,0.94));
            border: 1px solid rgba(148, 163, 184, 0.14);
            padding: 0.9rem 1rem;
        }

        .detail-stat-title {
            font-size: 0.76rem;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .detail-stat-value {
            margin-top: 0.25rem;
            font-size: 0.95rem;
            font-weight: 600;
            color: #0f172a;
        }

        .detail-sticky-stack {
            position: sticky;
            top: 1.25rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .detail-title-display {
            cursor: default;
            line-height: 1.1;
        }

        .detail-title-display.editable {
            cursor: pointer;
        }

        .detail-title-meta {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.85rem;
            margin-top: 0.85rem;
            color: #64748b;
        }

        .detail-comment-composer {
            display: flex;
            gap: 0.85rem;
            align-items: flex-end;
            margin-top: 1rem;
        }

        .detail-comment-composer .btn-comment-submit {
            min-width: 110px;
            border-radius: 14px;
        }

        .detail-actions-grid {
            display: grid;
            gap: 0.9rem;
        }

        .detail-select,
        .detail-input {
            border-radius: 14px;
        }

        .detail-input.dragover {
            border-color: #3b82f6;
            border-style: dashed;
            background: rgba(59, 130, 246, 0.04);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12);
        }

        .detail-section-note {
            font-size: 0.78rem;
            color: #64748b;
        }

        .detail-hero-actions {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .detail-avatar-row {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            min-width: 0;
        }

        .detail-avatar-copy {
            min-width: 0;
        }

        .detail-avatar-copy .title {
            font-weight: 600;
            color: #0f172a;
        }

        .detail-avatar-copy .subtitle {
            font-size: 0.78rem;
            color: #64748b;
        }

        .detail-description-tabs .nav-link {
            border-radius: 999px;
            border: none;
            color: #64748b;
            padding: 0.45rem 0.9rem;
        }

        .detail-description-tabs .nav-link.active {
            background: rgba(59, 130, 246, 0.10);
            color: #1d4ed8;
            font-weight: 600;
        }

        .comment-image-thumb {
            box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08);
        }

        .detail-empty {
            border-radius: 16px;
            border: 1px dashed rgba(148, 163, 184, 0.35);
            background: rgba(248,250,252,0.85);
            padding: 1rem;
            color: #64748b;
        }

        @@media (max-width: 991.98px) {
            .detail-sticky-stack {
                position: static;
            }
        }
    </style>
}

<div class="container-fluid card-detail-shell px-4 pt-4 pb-5">
    <div class="card-detail-hero mb-4" id="cardDetailRoot">
        <div class="d-flex flex-column flex-lg-row align-items-lg-start justify-content-between gap-3">
            <div class="min-w-0">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <a href="@backToBoardUrl" class="btn btn-outline-secondary btn-sm">
                        <i class="align-middle" style="width:16px;height:16px" data-lucide="arrow-left"></i>
                        @Localizer["Back to {0}", Model.BoardName]
                    </a>
                    <span class="detail-meta-chip">
                        <i class="align-middle" data-lucide="layout-grid" style="width:14px;height:14px"></i>
                        @Model.BoardName
                    </span>
                    <span class="detail-meta-chip">
                        <i class="align-middle" data-lucide="columns-3" style="width:14px;height:14px"></i>
                        <span data-current-column-name>@Model.ColumnName</span>
                    </span>
                </div>
                <h1 class="fw-bold mb-0 detail-title-display @(Model.CanEdit ? "editable" : string.Empty)" id="cardTitleDisplay">@Model.Title</h1>
                @if (Model.CanEdit)
                {
                    <input type="text" id="cardTitleInput" class="form-control form-control-lg d-none mt-2"
                           value="@Model.Title" style="border-radius:16px;font-size:1.55rem;font-weight:700" />
                }
                <div class="detail-title-meta" id="cardTitleMeta">
                    <span class="detail-meta-chip" data-assignee-name>
                        <i class="align-middle" data-lucide="user-check" style="width:14px;height:14px"></i>
                        @(string.IsNullOrWhiteSpace(Model.AssigneeName) ? Localizer["Unassigned"].Value : Model.AssigneeName)
                    </span>
                    <span class="detail-meta-chip">
                        <i class="align-middle" data-lucide="clock-3" style="width:14px;height:14px"></i>
                        <label data-utc-time="@Model.CreationTime.ToHtmlDateTime()"></label>
                    </span>
                    <span class="detail-meta-chip">
                        <i class="align-middle" data-lucide="message-circle" style="width:14px;height:14px"></i>
                        <span id="commentCount">@Model.Comments.Count</span> @Localizer["comments"]
                    </span>
                </div>
            </div>

            <div class="detail-hero-actions">
                @if (Model.CanEdit)
                {
                    <button class="btn btn-outline-danger" id="btnDeleteCard">
                        <i class="align-middle" style="width:16px;height:16px" data-lucide="trash-2"></i>
                        @Localizer["Delete"]
                    </button>
                }
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <section class="detail-surface">
                <div class="detail-surface-header">
                    <div>
                        <div class="fw-semibold">@Localizer["Description"]</div>
                    </div>
                    @if (Model.CanEdit)
                    {
                        <button class="btn btn-sm btn-outline-secondary" id="btnEditDesc">
                            <i class="align-middle" style="width:14px;height:14px" data-lucide="edit-3"></i>
                            @Localizer["Edit"]
                        </button>
                    }
                </div>
                <div class="detail-surface-body">
                    <div id="descriptionView">
                        <div id="descriptionEmpty" class="detail-empty @(string.IsNullOrWhiteSpace(Model.Description) ? string.Empty : "d-none")">
                            @Localizer["No description yet. Capture the context, plan, or acceptance notes for this card here."]
                        </div>
                        <div class="description-preview @(string.IsNullOrWhiteSpace(Model.Description) ? "d-none" : string.Empty)" id="descriptionPreview"></div>
                    </div>

                    @if (Model.CanEdit)
                    {
                        <div id="descriptionEdit" class="d-none">
                            <ul class="nav nav-tabs detail-description-tabs mb-3 border-0" aria-label="@Localizer["Markdown view mode"]">
                                <li class="nav-item">
                                    <button class="nav-link active" id="btnEditorTab" type="button">@Localizer["Edit"]</button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link" type="button" id="btnPreviewTab">@Localizer["Preview"]</button>
                                </li>
                            </ul>
                            <div>
                                <div id="descEditTab">
                                    <div class="detail-section-note mb-2">@Localizer["Markdown, Mermaid and MathJax are all supported."]</div>
                                    <div id="descEditorContainer" style="height:360px;border:1px solid var(--bs-border-color, #dee2e6);border-radius:14px;overflow:hidden"></div>
                                    <textarea id="descInitialValue" class="form-control" rows="12">@Model.Description</textarea>
                                </div>
                                <div id="descPreviewTab" hidden>
                                    <div class="description-preview border rounded-4 p-3 bg-light-subtle h-100" id="descLivePreview" style="min-height:360px"></div>
                                </div>
                            </div>
                            <div class="detail-section-note mt-2">@Localizer["Tip: paste an image directly into the editor to upload and embed it."]</div>
                            <div class="d-flex justify-content-end mt-3 gap-2">
                                <button class="btn btn-outline-secondary" id="btnCancelDesc">@Localizer["Cancel"]</button>
                                <button class="btn btn-primary" id="btnSaveDesc">@Localizer["Save"]</button>
                            </div>
                        </div>
                    }
                </div>
            </section>

            <section class="detail-surface mt-4">
                <div class="detail-surface-header">
                    <div>
                        <div class="fw-semibold">@Localizer["Comments"]</div>
                        <div class="detail-section-note d-none" id="commentSectionHint">@Localizer["Thread context, decisions, follow-ups and attachments stay with the card."]</div>
                    </div>
                </div>
                <div class="detail-surface-body">
                    <div id="commentsList">
                        @if (Model.Comments.Any())
                        {
                            @foreach (var comment in Model.Comments)
                            {
                                var images = (comment.Images ?? string.Empty)
                                    .Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                                <div class="comment-item" data-comment-id="@comment.Id">
                                    <div class="comment-avatar" style="background:@(string.IsNullOrEmpty(comment.AuthorAvatarUrl) ? "var(--bs-primary)" : "transparent")">
                                        @if (!string.IsNullOrEmpty(comment.AuthorAvatarUrl))
                                        {
                                            <img src="@comment.AuthorAvatarUrl" alt="@comment.AuthorName" class="card-assignee-avatar-image" />
                                        }
                                        else
                                        {
                                            @comment.AuthorInitial
                                        }
                                    </div>
                                    <div class="comment-body">
                                        <div class="comment-header">
                                            <span class="comment-author">@comment.AuthorName</span>
                                            <span class="comment-time">@comment.CreatedAt</span>
                                            @if (comment.CanDelete)
                                            {
                                                <button class="comment-delete-btn" data-comment-id="@comment.Id" title="@Localizer["Delete comment"]">
                                                    <i class="align-middle" style="width:14px;height:14px" data-lucide="trash-2"></i>
                                                </button>
                                            }
                                        </div>
                                        <div class="comment-text">@comment.Content</div>
                                        @if (images.Any())
                                        {
                                            <div class="comment-images mt-2 d-flex gap-2 flex-wrap">
                                                @foreach (var image in images)
                                                {
                                                    <img src="@image" data-fullscreen-src="@image" class="comment-image-thumb" style="height:72px;max-width:120px;object-fit:cover;border-radius:10px;cursor:pointer;border:1px solid var(--bs-border-color, #dee2e6);" alt="@Localizer["comment image"]" />
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="comment-empty-hint">@Localizer["No comments yet."]</p>
                        }
                    </div>

                    @if (Model.CanEdit)
                    {
                        <div class="detail-comment-composer">
                            <div class="flex-grow-1">
                                <textarea id="commentInput" class="form-control detail-input" rows="3" placeholder="@Localizer["Write a comment... (Ctrl+Enter to send)"]"></textarea>
                                <div class="detail-section-note mt-2 d-none" id="commentDragHint">@Localizer["Drag an image here or paste from clipboard to attach it to the comment."]</div>
                            </div>
                            <button class="btn btn-primary btn-comment-submit" id="btnAddComment">
                                <i class="align-middle" style="width:16px;height:16px" data-lucide="send"></i>
                                @Localizer["Send"]
                            </button>
                        </div>
                    }
                </div>
            </section>
        </div>

        <div class="col-lg-4">
            <div class="detail-sticky-stack">
                <section class="detail-surface">
                    <div class="detail-surface-header">
                        <div>
                            <div class="fw-semibold">@Localizer["Overview"]</div>
                            <div class="detail-section-note">@Localizer["Context around ownership, status and where this card currently lives."]</div>
                        </div>
                    </div>
                    <div class="detail-surface-body">
                        <div class="detail-kv">
                            <div class="detail-kv-label">@Localizer["Board"]</div>
                            <div class="detail-kv-value fw-semibold">@Model.BoardName</div>
                        </div>
                        <div class="detail-kv">
                            <div class="detail-kv-label">@Localizer["Column"]</div>
                            <div class="detail-kv-value fw-semibold" data-current-column-name>@Model.ColumnName</div>
                        </div>
                        <div class="detail-kv">
                            <div class="detail-kv-label">@Localizer["Assignee"]</div>
                            <div class="detail-kv-value">
                                <div id="overviewAssigneeView">
                                    <div class="detail-avatar-row" id="overviewAssignee">
                                        @if (!string.IsNullOrWhiteSpace(Model.AssigneeId))
                                        {
                                            <span class="card-assignee-avatar">
                                                @if (!string.IsNullOrEmpty(Model.AssigneeAvatarUrl))
                                                {
                                                    <img src="@Model.AssigneeAvatarUrl" alt="@Model.AssigneeName" class="card-assignee-avatar-image" />
                                                }
                                                else
                                                {
                                                    @Model.AssigneeInitial
                                                }
                                            </span>
                                            <div class="detail-avatar-copy">
                                                <div class="title">@Model.AssigneeName</div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">@Localizer["Unassigned"]</span>
                                        }
                                        @if (Model.CanEdit)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary ms-1" id="btnEditAssignee" title="@Localizer["Edit assignee"]" style="border-radius:12px;flex-shrink:0">
                                                <i class="align-middle" style="width:14px;height:14px" data-lucide="pencil"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                                @if (Model.CanEdit)
                                {
                                    <div id="overviewAssigneeEdit" class="d-none">
                                        <div class="d-flex gap-2 mb-2">
                                            <input type="text" id="overviewAssigneeSearch" class="form-control detail-input" placeholder="@Localizer["Search assignee..."]" autocomplete="off" />
                                            <button class="btn btn-outline-danger" type="button" id="btnOverviewClearAssignee">@Localizer["Clear"]</button>
                                        </div>
                                        <div id="overviewAssigneeDropdown" class="list-group d-none shadow-sm" style="max-height:220px;overflow-y:auto;border-radius:16px"></div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="detail-kv">
                            <div class="detail-kv-label">@Localizer["Creator"]</div>
                            <div class="detail-kv-value detail-avatar-row">
                                <span class="card-assignee-avatar">
                                    @if (!string.IsNullOrEmpty(Model.CreatorAvatarUrl))
                                    {
                                        <img src="@Model.CreatorAvatarUrl" alt="@Model.CreatorName" class="card-assignee-avatar-image" />
                                    }
                                    else
                                    {
                                        @Model.CreatorInitial
                                    }
                                </span>
                                <div class="detail-avatar-copy">
                                    <div class="title">@Model.CreatorName</div>
                                    <div class="subtitle">@Localizer["Created"] <label data-utc-time="@Model.CreationTime.ToHtmlDateTime()" style="display:inline"></label></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="detail-surface">
                    <div class="detail-surface-header">
                        <div>
                            <div class="fw-semibold">@Localizer["Schedule & status"]</div>
                            <div class="detail-section-note">@Localizer["This is the planning and execution timeline for the card."]</div>
                        </div>
                    </div>
                    <div class="detail-surface-body">
                        <div class="mb-3">
                            <div class="fw-semibold small text-muted mb-2">@Localizer["Priority"]</div>
                            <div class="d-flex flex-wrap gap-2" id="priorityGroup">
                                @{
                                    var priorities = new[] { (Localizer["Urgent"].Value, "priority-urgent"), (Localizer["High"].Value, "priority-high"), (Localizer["Medium"].Value, "priority-medium"), (Localizer["Low"].Value, "priority-low"), (Localizer["None"].Value, "") };
                                    for (int i = 0; i < priorities.Length; i++)
                                    {
                                        var (name, cls) = priorities[i];
                                        var isActive = i == Model.Priority;
                                        <span class="priority-badge @(isActive ? cls : "") @(isActive ? "" : "text-muted") @(Model.CanEdit ? "priority-selectable" : "")"
                                              data-priority="@i"
                                              style="@(Model.CanEdit ? "cursor:pointer" : "")">
                                            @name
                                        </span>
                                    }
                                }
                            </div>
                        </div>

                        <div class="detail-kv">
                            <div class="detail-kv-label">@Localizer["Start"]</div>
                            <div class="detail-kv-value">
                                <input type="date" id="inputPlannedStart" class="form-control detail-input" value="@Model.PlannedStartDate" @(Model.CanEdit ? "" : "disabled") />
                            </div>
                        </div>
                        <div class="detail-kv">
                            <div class="detail-kv-label">@Localizer["Due"]</div>
                            <div class="detail-kv-value">
                                <input type="date" id="inputDueDate" class="form-control detail-input" value="@Model.DueDate" @(Model.CanEdit ? "" : "disabled") />
                            </div>
                        </div>

                        <div class="row g-2 mb-3 mt-1">
                            <div class="col-6">
                                <div class="detail-stat-box">
                                    <div class="detail-stat-title">@Localizer["Actual start"]</div>
                                    <div class="detail-stat-value">
                                        @if (Model.ActualStartDate.HasValue) { <label data-utc-time="@Model.ActualStartDate.Value.ToHtmlDateTime()"></label> } else { <span>—</span> }
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="detail-stat-box">
                                    <div class="detail-stat-title">@Localizer["Actual end"]</div>
                                    <div class="detail-stat-value">
                                        @if (Model.ActualEndDate.HasValue) { <label data-utc-time="@Model.ActualEndDate.Value.ToHtmlDateTime()"></label> } else { <span>—</span> }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="inputRecurring" @(Model.IsRecurring ? "checked" : null) @(Model.CanEdit ? null : "disabled")>
                            <label class="form-check-label fw-semibold" for="inputRecurring">@Localizer["Recurring task"]</label>
                        </div>
                        <div id="recurrenceFields" class="@(Model.IsRecurring ? string.Empty : "d-none")">
                            <div class="input-group">
                                <span class="input-group-text" style="border-radius:14px 0 0 14px">@Localizer["Every"]</span>
                                <input type="number" id="inputRecurrenceInterval" min="1" max="365" class="form-control" value="@Model.RecurrenceInterval" placeholder="1" @(Model.CanEdit ? null : "disabled")>
                                <select id="inputRecurrenceUnit" class="form-select" @(Model.CanEdit ? null : "disabled") style="border-radius:0 14px 14px 0">
                                    <!option value="0" @(Model.RecurrenceUnit == 0 ? "selected" : null)>@Localizer["Select unit"]</!option>
                                    <!option value="1" @(Model.RecurrenceUnit == 1 ? "selected" : null)>@Localizer["Days"]</!option>
                                    <!option value="2" @(Model.RecurrenceUnit == 2 ? "selected" : null)>@Localizer["Weeks"]</!option>
                                    <!option value="3" @(Model.RecurrenceUnit == 3 ? "selected" : null)>@Localizer["Months"]</!option>
                                    <!option value="4" @(Model.RecurrenceUnit == 4 ? "selected" : null)>@Localizer["Years"]</!option>
                                </select>
                            </div>
                            <div class="detail-section-note mt-2">@Localizer["Recurring cards require a due date, interval and recurrence unit."]</div>
                        </div>
                    </div>
                </section>

                <section class="detail-surface">
                    <div class="detail-surface-header">
                        <div>
                            <div class="fw-semibold">@Localizer["Labels"]</div>
                            <div class="detail-section-note">@Localizer["Use labels to cluster work across the board and the detail page."]</div>
                        </div>
                    </div>
                    <div class="detail-surface-body">
                        @if (Model.CanEdit)
                        {
                            <div class="input-group mb-3">
                                <input type="text" id="labelSearchInput" class="form-control" list="labelSuggestions" placeholder="@Localizer["Search or create a label"]" style="border-radius:14px">
                                <button type="button" class="btn btn-outline-secondary" id="btnAddLabel" style="border-radius:14px">@Localizer["Add"]</button>
                            </div>
                            <datalist id="labelSuggestions"></datalist>
                        }
                        <div id="labelsDisplay" class="d-flex flex-wrap gap-2"></div>
                    </div>
                </section>

                @if (Model.CanEdit)
                {
                    <section class="detail-surface">
                        <div class="detail-surface-header">
                            <div>
                                <div class="fw-semibold">@Localizer["Actions"]</div>
                                <div class="detail-section-note">@Localizer["Move within this board or transfer ownership to another board."]</div>
                            </div>
                        </div>
                        <div class="detail-surface-body">
                            <div class="detail-actions-grid">
                                <div>
                                    <label class="form-label small fw-semibold text-muted">@Localizer["Move to column"]</label>
                                    <div class="d-flex gap-2">
                                        <select id="moveTargetColumn" class="form-select detail-select">
                                            @foreach (var col in Model.Columns)
                                            {
                                                <!option value="@col.Id" @(col.Id == Model.ColumnId ? "selected" : null)>@col.Name</!option>
                                            }
                                        </select>
                                        <button class="btn btn-outline-primary" id="btnMoveCard">@Localizer["Move"]</button>
                                    </div>
                                </div>

                                @if (Model.AvailableBoards.Any())
                                {
                                    <div>
                                        <label class="form-label small fw-semibold text-muted">@Localizer["Transfer"]</label>
                                        <div class="d-grid gap-2">
                                            <select id="transferTargetBoard" class="form-select detail-select">
                                                <option value="">@Localizer["Select board..."]</option>
                                                @foreach (var board in Model.AvailableBoards)
                                                {
                                                    <option value="@board.Id">@board.Name</option>
                                                }
                                            </select>
                                            <select id="transferTargetColumn" class="form-select detail-select" disabled>
                                                <option value="">@Localizer["Select column..."]</option>
                                            </select>
                                            <div class="detail-section-note">@Localizer["Comments will stay with the current card history, and assignee may be re-evaluated on the target board."]</div>
                                            <button class="btn btn-outline-primary" id="btnTransferCard">@Localizer["Transfer"]</button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </section>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteCardModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg" style="border-radius:20px">
            <div class="modal-header border-0 px-4 pt-4">
                <h5 class="modal-title fw-bold text-danger">
                    <i class="align-middle me-2" data-lucide="alert-triangle"></i>@Localizer["Delete card"]
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4">
                <p class="mb-0">@Localizer["Are you sure you want to delete this card? This action cannot be undone."]</p>
            </div>
            <div class="modal-footer border-0 px-4 pb-4">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius:12px">@Localizer["Cancel"]</button>
                <button type="button" class="btn btn-danger" id="btnConfirmDeleteCard" style="border-radius:12px">@Localizer["Delete"]</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteCommentConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg" style="border-radius:20px">
            <div class="modal-header border-0 px-4 pt-4">
                <h5 class="modal-title fw-bold text-danger">
                    <i class="align-middle me-2" data-lucide="alert-triangle"></i>@Localizer["Delete comment"]
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4">
                <p class="mb-0">@Localizer["This action cannot be undone."]</p>
                <div class="alert alert-danger mt-3 d-none" id="deleteCommentError"></div>
            </div>
            <div class="modal-footer border-0 px-4 pb-4">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius:12px">@Localizer["Cancel"]</button>
                <button type="button" class="btn btn-danger" id="btnConfirmDeleteComment" style="border-radius:12px">@Localizer["Delete"]</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="friendlyAlertModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg" style="border-radius:20px">
            <div class="modal-header border-0 px-4 pt-4">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="friendlyAlertTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4">
                <div class="d-flex align-items-start gap-3">
                    <i class="align-middle text-danger" id="friendlyAlertIcon" data-lucide="alert-circle"></i>
                    <p class="mb-0" id="friendlyAlertMessage"></p>
