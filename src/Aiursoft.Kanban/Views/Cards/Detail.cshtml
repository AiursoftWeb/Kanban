@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script src="~/node_modules/lucide/dist/umd/lucide.min.js"></script>
    @{
        ViewData["MarkdownTheme"] = isDarkMode ? "dark" : "default";
    }
    <partial name="_MarkdownReaderAssets" />
    <script>var require = { paths: { 'vs': '/node_modules/monaco-editor/min/vs' } };</script>
    <script src="~/node_modules/monaco-editor/min/vs/loader.js" asp-append-version="true"></script>
    <script type="module">
        import { initCardDetailPage } from '/dist/card-detail-page.js';

        // Wait for defer scripts (AiursoftMarkdownUi, etc.) before initializing.
        // Defer scripts execute before DOMContentLoaded, so all libraries are ready here.
        document.addEventListener('DOMContentLoaded', () => {
            initCardDetailPage({
                csrfToken: '@token',
                cardId: @Model.CardId,
                boardId: @Model.BoardId,
                returnBoardId: @Model.ReturnBoardId,
                canEdit: @Model.CanEdit.ToString().ToLowerInvariant(),
                imageUploadUrl: '@kanbanImageUploadUrl',
                markdownEditorTheme: '@(isDarkMode ? "vs-dark" : "vs")',
                mermaidTheme: '@(isDarkMode ? "dark" : "default")',
                returnBoardUrl: '@returnBoardUrl',
                initialTitle: @Html.Raw(JsonSerializer.Serialize(Model.Title)),
                initialPriority: @Model.Priority,
                initialAssigneeId: @Html.Raw(JsonSerializer.Serialize(Model.AssigneeId)),
                initialAssigneeName: @Html.Raw(JsonSerializer.Serialize(Model.AssigneeName)),
                initialAssigneeInitial: @Html.Raw(JsonSerializer.Serialize(Model.AssigneeInitial)),
                initialAssigneeAvatarUrl: @Html.Raw(JsonSerializer.Serialize(Model.AssigneeAvatarUrl)),
                initialLabels: @Html.Raw(JsonSerializer.Serialize(Model.Labels.Select(l => new { id = l.Id, name = l.Name, color = l.Color })))
            });
        });
    </script>
}
