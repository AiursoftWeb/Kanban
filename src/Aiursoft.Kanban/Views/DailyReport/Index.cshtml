@using Aiursoft.Kanban.Models.DailyReportViewModels
@using Aiursoft.Kanban.Entities
@using Aiursoft.WebTools
@model DailyReportIndexViewModel

@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/node_modules/@@highlightjs/cdn-assets/styles/github.min.css" asp-append-version="true" />
<style>
    .today-highlight {
        border-left: 4px solid var(--bs-primary);
        background: var(--bs-primary-bg-subtle);
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .today-highlight.summary {
        border-left-color: var(--bs-success);
        background: var(--bs-success-bg-subtle);
    }

    .highlight-badge {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    /* Exact copy of .description-preview from card.css */
    .description-preview {
        color: var(--bs-body-color);
        line-height: 1.55;
    }

    .description-preview > :last-child {
        margin-bottom: 0;
    }

    .description-preview pre {
        padding: 0.75rem;
        border-radius: 8px;
        background: var(--bs-tertiary-bg, #f8f9fa);
        overflow-x: auto;
    }

    .description-preview code {
        font-size: 0.85em;
    }

    .description-preview table {
        width: 100%;
        margin-bottom: 1rem;
        border-collapse: collapse;
    }

    .description-preview th,
    .description-preview td {
        padding: 0.4rem 0.55rem;
        border: 1px solid var(--bs-border-color, #dee2e6);
    }

    .description-preview blockquote {
        margin: 0 0 1rem;
        padding: 0.5rem 0.8rem;
        border-left: 4px solid var(--bs-primary, #4dabf7);
        background: var(--bs-tertiary-bg, #f8f9fa);
        color: var(--bs-secondary-color);
        border-radius: 0 8px 8px 0;
    }

    .description-preview img,
    .description-preview svg {
        max-width: 100%;
        height: auto;
    }

    /* Highlight preview uses description-preview styles with line clamp */
    .highlight-preview {
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
        font-size: 0.9rem;
    }

    /* Plain-text preview for history table */
    .report-content-preview {
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
        color: var(--bs-secondary-color);
        font-size: 0.9rem;
        line-height: 1.6;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .clickable-row {
        cursor: pointer;
    }

    .clickable-row:hover {
        background: var(--bs-tertiary-bg);
    }

    .type-badge-plan {
        background: var(--bs-primary);
        color: #fff;
    }

    .type-badge-summary {
        background: var(--bs-success);
        color: #fff;
    }

    .empty-state {
        border: 2px dashed var(--bs-border-color);
        border-radius: 18px;
        padding: 4rem 2rem;
        text-align: center;
        color: var(--bs-secondary-color);
        background: var(--bs-tertiary-bg);
    }

    .pagination-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1.5rem;
    }
</style>
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="mb-1">@Localizer["Daily Assistant"]</h2>
        <p class="text-muted mb-0">@Localizer["AI-powered daily planning and summaries based on your Kanban boards."]</p>
    </div>
</div>

@* ── Today's Highlight Section ── *@
@* Before 4pm: show the daily plan. After 4pm: show the daily summary. *@

@if (Model.CanPlan)
{
    @* ── Morning: Plan Section ── *@
    @if (Model.TodayPlan != null)
    {
        <div class="today-highlight">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div>
                    <span class="badge type-badge-plan highlight-badge me-2">@Localizer["Today's Plan"]</span>
                    <small class="text-muted">@Localizer["Generated"] <label data-utc-time="@Model.TodayPlan.GeneratedAt.ToHtmlDateTime()" style="display:inline"></label></small>
                </div>
                <div class="d-flex gap-2">
                    <a href="/DailyReport/Details/@Model.TodayPlan.Id" class="btn btn-sm btn-outline-secondary">
                        <i class="align-middle me-1" data-lucide="eye"></i> @Localizer["View"]
                    </a>
                    <form method="post" action="/DailyReport/Regenerate" style="display:inline">
                        <input type="hidden" name="type" value="plan" />
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-primary">
                            <i class="align-middle me-1" data-lucide="refresh-cw"></i> @Localizer["Regenerate"]
                        </button>
                    </form>
                </div>
            </div>
            <div class="description-preview highlight-preview" id="todayPlanPreview"></div>
            <textarea id="todayPlanRaw" class="d-none">@Model.TodayPlan.Content</textarea>
        </div>
    }
    else
    {
        <div class="today-highlight">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="badge type-badge-plan highlight-badge me-2">@Localizer["Today's Plan"]</span>
                    <small class="text-muted">@Localizer["Not yet generated"]</small>
                </div>
                <form method="post" action="/DailyReport/Regenerate" style="display:inline">
                    <input type="hidden" name="type" value="plan" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="align-middle me-1" data-lucide="sparkles"></i> @Localizer["Generate Plan"]
                    </button>
                </form>
            </div>
            <p class="text-muted mt-2 mb-0">@Localizer["Generate a morning plan to see what you should focus on today."]</p>
        </div>
    }
}
else if (Model.CanSummarize)
{
    @* ── Afternoon: Summary Section ── *@
    @if (Model.TodaySummary != null)
    {
        <div class="today-highlight summary">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div>
                    <span class="badge type-badge-summary highlight-badge me-2">@Localizer["Today's Summary"]</span>
                    <small class="text-muted">@Localizer["Generated"] <label data-utc-time="@Model.TodaySummary.GeneratedAt.ToHtmlDateTime()" style="display:inline"></label></small>
                </div>
                <div class="d-flex gap-2">
                    <a href="/DailyReport/Details/@Model.TodaySummary.Id" class="btn btn-sm btn-outline-secondary">
                        <i class="align-middle me-1" data-lucide="eye"></i> @Localizer["View"]
                    </a>
                    <form method="post" action="/DailyReport/Regenerate" style="display:inline">
                        <input type="hidden" name="type" value="summary" />
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-success">
                            <i class="align-middle me-1" data-lucide="refresh-cw"></i> @Localizer["Regenerate"]
                        </button>
                    </form>
                </div>
            </div>
            <div class="description-preview highlight-preview" id="todaySummaryPreview"></div>
            <textarea id="todaySummaryRaw" class="d-none">@Model.TodaySummary.Content</textarea>
        </div>
    }
    else
    {
        <div class="today-highlight summary">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="badge type-badge-summary highlight-badge me-2">@Localizer["Today's Summary"]</span>
                    <small class="text-muted">@Localizer["Not yet generated"]</small>
                </div>
                <form method="post" action="/DailyReport/Regenerate" style="display:inline">
                    <input type="hidden" name="type" value="summary" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-success">
                        <i class="align-middle me-1" data-lucide="sparkles"></i> @Localizer["Generate Summary"]
                    </button>
                </form>
            </div>
            <p class="text-muted mt-2 mb-0">@Localizer["Generate an afternoon summary to reflect on what you accomplished today."]</p>
        </div>
    }
}

@* ── History Section ── *@

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">@Localizer["History"]</h5>
    </div>
    <div class="table-responsive">
        @if (Model.Reports.Count == 0)
        {
            <div class="empty-state m-3">
                <h4 class="mb-2">@Localizer["No reports yet"]</h4>
                <p class="mb-0">@Localizer["Your daily plans and summaries will appear here."]</p>
            </div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>@Localizer["Date"]</th>
                        <th>@Localizer["Type"]</th>
                        <th>@Localizer["Preview"]</th>
                        <th>@Localizer["Generated At"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var report in Model.Reports)
                    {
                        var isToday = report.Date.Date == (DateTime.UtcNow + TimeSpan.FromHours(8)).Date;
                        <tr class="clickable-row @(isToday ? "table-active" : "")" data-href="/DailyReport/Details/@report.Id">
                            <td>
                                @report.Date.ToString("yyyy-MM-dd")
                                @if (isToday)
                                {
                                    <span class="badge bg-info ms-1">@Localizer["Today"]</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(report.ReportType == DailyReportType.Plan ? "type-badge-plan" : "type-badge-summary")">
                                    @(report.ReportType == DailyReportType.Plan ? Localizer["Plan"].Value : Localizer["Summary"].Value)
                                </span>
                            </td>
                            <td>
                                <div class="report-content-preview" data-raw-content="@TruncateContent(report.Content, 150)"></div>
                            </td>
                            <td class="text-muted"><label data-utc-time="@report.GeneratedAt.ToHtmlDateTime()" style="display:inline"></label></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @* ── Pagination ── *@
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer">
            <div class="pagination-container">
                <a href="/DailyReport?page=@(Model.CurrentPage - 1)"
                   class="btn btn-sm btn-outline-secondary @(Model.CurrentPage <= 1 ? "disabled" : "")">
                    <i class="align-middle" data-lucide="chevron-left"></i> @Localizer["Previous"]
                </a>

                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <a href="/DailyReport?page=@i"
                       class="btn btn-sm @(i == Model.CurrentPage ? "btn-primary" : "btn-outline-secondary")">
                        @i
                    </a>
                }

                <a href="/DailyReport?page=@(Model.CurrentPage + 1)"
                   class="btn btn-sm btn-outline-secondary @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                    @Localizer["Next"] <i class="align-middle" data-lucide="chevron-right"></i>
                </a>
            </div>
        </div>
    }
</div>

@functions {
    string TruncateContent(string content, int maxLen)
    {
        if (string.IsNullOrEmpty(content)) return "";
        return content.Length <= maxLen ? content : content[..maxLen] + "…";
    }
}

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
<script src="~/node_modules/markdown-it/dist/markdown-it.min.js" asp-append-version="true"></script>
<script src="~/node_modules/dompurify/dist/purify.min.js" asp-append-version="true"></script>
<partial name="_MarkdownReaderAssets" />
<script>
    document.querySelectorAll('.clickable-row').forEach(function(row) {
        row.addEventListener('click', function() {
            var href = this.dataset.href;
            if (href) window.location.href = href;
        });
    });

    function stripMarkdown(md) {
        if (!md) return '';
        return md
            .replace(/^#{1,6}\s+/gm, '')
            .replace(/\*\*(.+?)\*\*/g, '$1')
            .replace(/\*(.+?)\*/g, '$1')
            .replace(/`{1,3}[^`]*`{1,3}/g, '')
            .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
            .replace(/!\[([^\]]*)\]\([^)]+\)/g, '$1')
            .replace(/^>\s+/gm, '')
            .replace(/^[-*+]\s+/gm, '')
            .replace(/^\d+\.\s+/gm, '')
            .replace(/~~(.+?)~~/g, '$1')
            .replace(/^---+$/gm, '')
            .trim();
    }

    (function () {
        // Render today's highlight — exact same approach as card description
        var planRaw = document.getElementById('todayPlanRaw');
        var planTarget = document.getElementById('todayPlanPreview');
        if (planRaw && planTarget && typeof markdownit !== 'undefined' && typeof DOMPurify !== 'undefined') {
            var rawHtml = markdownit({ html: false, linkify: true, breaks: true, typographer: true }).render(planRaw.value);
            var cleanHtml = DOMPurify.sanitize(rawHtml, {
                ADD_ATTR: ['target'],
                FORBID_TAGS: ['script', 'style'],
                FORBID_ATTR: ['style'],
            });
            planTarget.innerHTML = cleanHtml;
            planTarget.classList.add('markdown-content');
            planTarget.querySelectorAll('a[href]').forEach(function (link) {
                link.rel = 'noopener noreferrer';
                link.target = '_blank';
            });
        }

        var summaryRaw = document.getElementById('todaySummaryRaw');
        var summaryTarget = document.getElementById('todaySummaryPreview');
        if (summaryRaw && summaryTarget && typeof markdownit !== 'undefined' && typeof DOMPurify !== 'undefined') {
            var rawHtml2 = markdownit({ html: false, linkify: true, breaks: true, typographer: true }).render(summaryRaw.value);
            var cleanHtml2 = DOMPurify.sanitize(rawHtml2, {
                ADD_ATTR: ['target'],
                FORBID_TAGS: ['script', 'style'],
                FORBID_ATTR: ['style'],
            });
            summaryTarget.innerHTML = cleanHtml2;
            summaryTarget.classList.add('markdown-content');
            summaryTarget.querySelectorAll('a[href]').forEach(function (link) {
                link.rel = 'noopener noreferrer';
                link.target = '_blank';
            });
        }

        // Strip markdown from history table previews
        document.querySelectorAll('.report-content-preview[data-raw-content]').forEach(function (el) {
            var raw = el.getAttribute('data-raw-content') || '';
            el.textContent = stripMarkdown(raw);
        });
    })();
</script>
}
