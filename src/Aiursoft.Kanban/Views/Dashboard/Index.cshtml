@using Aiursoft.Kanban.Entities
@using Aiursoft.WebTools
@model Aiursoft.Kanban.Models.DashboardViewModels.IndexViewModel
@{
    string PriorityClass(Priority priority)
    {
        return priority switch
        {
            Priority.Urgent => "priority-urgent",
            Priority.High => "priority-high",
            Priority.Medium => "priority-medium",
            Priority.Low => "priority-low",
            _ => "priority-none"
        };
    }

    string StatusText(ColumnStatus status)
    {
        return status switch
        {
            ColumnStatus.NotStarted => "Not Started",
            ColumnStatus.InProgress => "In Progress",
            ColumnStatus.Completed => "Completed",
            _ => status.ToString()
        };
    }

    string PermissionText(SharePermission? permission)
    {
        return permission switch
        {
            SharePermission.Editable => "Editable",
            SharePermission.ReadOnly => "Read only",
            _ => string.Empty
        };
    }
}

@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/node_modules/@@highlightjs/cdn-assets/styles/github.min.css" asp-append-version="true" />
<style>
    .dashboard-stat {
        border: 1px solid var(--bs-border-color);
        background: var(--bs-body-bg);
        border-radius: 8px;
    }

    .dashboard-stat .stat {
        width: 42px;
        height: 42px;
    }

    .dashboard-board {
        display: block;
        height: 100%;
        color: inherit;
        text-decoration: none;
        border: 1px solid var(--bs-border-color);
        border-radius: 8px;
        background: var(--bs-body-bg);
        transition: box-shadow 0.2s ease, transform 0.15s ease;
    }

    .dashboard-board:hover {
        color: inherit;
        transform: translateY(-2px);
        box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.08);
    }

    .dashboard-meta,
    .task-labels {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: center;
    }

    .priority-badge,
    .label-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 600;
        border: 1px solid var(--bs-border-color);
        color: var(--bs-secondary-color);
        background: var(--bs-tertiary-bg);
    }

    .priority-urgent { background: rgba(220, 53, 69, 0.14); color: #dc3545; }
    .priority-high { background: rgba(253, 126, 20, 0.14); color: #fd7e14; }
    .priority-medium { background: rgba(255, 193, 7, 0.18); color: #8a6d00; }
    .priority-low { background: rgba(13, 110, 253, 0.14); color: #0d6efd; }
    .report-content-preview {
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
        color: var(--bs-secondary-color);
        font-size: 0.9rem;
        line-height: 1.6;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .dashboard-report {
        border-left: 4px solid var(--bs-primary);
        background: var(--bs-primary-bg-subtle);
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1rem;
    }

    .dashboard-report.summary {
        border-left-color: var(--bs-success);
        background: var(--bs-success-bg-subtle);
    }
</style>
}

<div class="row mb-2 mb-xl-3">
    <div class="col-auto d-none d-sm-block">
        <h3>@Localizer["Kanban Dashboard"]</h3>
    </div>

    <div class="col-auto ms-auto text-end mt-n1">
        <a asp-controller="Kanban" asp-action="Index" class="btn btn-primary me-2 shadow-sm">
            <i class="align-middle" data-lucide="columns-3"></i> @Localizer["Open boards"]
        </a>
        <a asp-controller="MyTasks" asp-action="Index" class="btn btn-outline-primary shadow-sm">
            <i class="align-middle" data-lucide="list-checks"></i> @Localizer["My tasks"]
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="dashboard-stat p-3 h-100">
            <div class="d-flex align-items-center">
                <div class="stat me-3">
                    <i class="align-middle" data-lucide="briefcase"></i>
                </div>
                <div>
                    <div class="text-muted small">@Localizer["My boards"]</div>
                    <div class="fs-3 fw-bold">@Model.OwnedBoardCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="dashboard-stat p-3 h-100">
            <div class="d-flex align-items-center">
                <div class="stat me-3">
                    <i class="align-middle" data-lucide="share-2"></i>
                </div>
                <div>
                    <div class="text-muted small">@Localizer["Shared boards"]</div>
                    <div class="fs-3 fw-bold">@Model.SharedBoardCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="dashboard-stat p-3 h-100">
            <div class="d-flex align-items-center">
                <div class="stat me-3">
                    <i class="align-middle" data-lucide="clipboard-list"></i>
                </div>
                <div>
                    <div class="text-muted small">@Localizer["Assigned tasks"]</div>
                    <div class="fs-3 fw-bold">@Model.AssignedTaskCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="dashboard-stat p-3 h-100">
            <div class="d-flex align-items-center">
                <div class="stat me-3">
                    <i class="align-middle" data-lucide="alarm-clock"></i>
                </div>
                <div>
                    <div class="text-muted small">@Localizer["Overdue"]</div>
                    <div class="fs-3 fw-bold">@Model.OverdueTaskCount</div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.LatestPlan != null || Model.LatestSummary != null)
{
<div class="row g-4 mb-4">
    @if (Model.LatestPlan != null)
    {
    <div class="col-12 @(Model.LatestSummary != null ? "col-xl-6" : "col-xl-12")">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-header bg-transparent d-flex align-items-center justify-content-between">
                <h5 class="card-title mb-0">
                    <i class="align-middle me-2 text-primary" data-lucide="clipboard-list"></i> @Localizer["Today's Plan"]
                </h5>
                <a asp-controller="DailyReport" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="align-middle" data-lucide="external-link"></i>
                </a>
            </div>
            <div class="card-body">
                <div class="description-preview" id="dashboardPlanPreview" style="max-height: 400px; overflow-y: auto;"></div>
                <textarea id="dashboardPlanRaw" class="d-none">@Model.LatestPlan.Content</textarea>
                <div class="text-muted small mt-2">
                    @Localizer["Generated at:"] <span data-utc-time="@Model.LatestPlan.GeneratedAt.ToHtmlDateTime()"></span>
                </div>
            </div>
        </div>
    </div>
    }
    @if (Model.LatestSummary != null)
    {
    <div class="col-12 @(Model.LatestPlan != null ? "col-xl-6" : "col-xl-12")">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-header bg-transparent d-flex align-items-center justify-content-between">
                <h5 class="card-title mb-0">
                    <i class="align-middle me-2 text-success" data-lucide="file-text"></i> @Localizer["Today's Summary"]
                </h5>
                <a asp-controller="DailyReport" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="align-middle" data-lucide="external-link"></i>
                </a>
            </div>
            <div class="card-body">
                <div class="description-preview" id="dashboardSummaryPreview" style="max-height: 400px; overflow-y: auto;"></div>
                <textarea id="dashboardSummaryRaw" class="d-none">@Model.LatestSummary.Content</textarea>
                <div class="text-muted small mt-2">
                    @Localizer["Generated at:"] <span data-utc-time="@Model.LatestSummary.GeneratedAt.ToHtmlDateTime()"></span>
                </div>
            </div>
        </div>
    </div>
    }
</div>
}

<div class="row g-4 mb-4">
    <div class="col-12 col-xl-8">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-header bg-transparent d-flex flex-wrap align-items-center gap-2 justify-content-between">
                <h5 class="card-title mb-0"><i class="align-middle me-2 text-primary" data-lucide="list-checks"></i> @Localizer["My active tasks"]</h5>
                <span class="badge bg-primary-subtle text-primary-emphasis">@Model.InProgressTaskCount @Localizer["in progress"]</span>
            </div>
            <div class="list-group list-group-flush">
                @if (Model.AssignedTasks.Any())
                {
                    @foreach (var card in Model.AssignedTasks)
                    {
                        <a asp-controller="Kanban" asp-action="Index" asp-route-boardId="@card.Column.BoardId" class="list-group-item list-group-item-action p-3">
                            <div class="d-flex flex-wrap justify-content-between gap-3">
                                <div>
                                    <div class="dashboard-meta mb-2">
                                        @if (card.Priority != Priority.None)
                                        {
                                            <span class="priority-badge @PriorityClass(card.Priority)">@card.Priority</span>
                                        }
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis">@Localizer[StatusText(card.Column.ColumnStatus)]</span>
                                    </div>
                                    <div class="fw-bold">@card.Title</div>
                                    <div class="text-muted small">@card.Column.Board.Name / @card.Column.Name</div>
                                </div>
                                <div class="text-muted small text-md-end">
                                    @if (card.DueDate.HasValue)
                                    {
                                        <span>@Localizer["Due:"] <span data-utc-time="@card.DueDate.Value.ToHtmlDateTime()"></span></span>
                                    }
                                    else
                                    {
                                        <span>@Localizer["No due date"]</span>
                                    }
                                </div>
                            </div>
                            @if (card.CardLabels.Count > 0)
                            {
                                <div class="task-labels mt-3">
                                    @foreach (var label in card.CardLabels.OrderBy(link => link.Label.Name))
                                    {
                                        <span class="label-chip" style="background-color:@(label.Label.Color)22;border-color:@label.Label.Color;color:@label.Label.Color;">
                                            @label.Label.Name
                                        </span>
                                    }
                                </div>
                            }
                        </a>
                    }
                }
                else
                {
                    <div class="list-group-item text-muted p-4 text-center">
                        <i class="mb-2 d-block opacity-50" data-lucide="smile" style="width: 40px; height: 40px; margin: 0 auto;"></i>
                        @Localizer["No active tasks assigned to you right now."]
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-header bg-transparent">
                <h5 class="card-title mb-0"><i class="align-middle me-2 text-success" data-lucide="zap"></i> @Localizer["Quick actions"]</h5>
            </div>
            <div class="list-group list-group-flush">
                <a asp-controller="Kanban" asp-action="Index" class="list-group-item list-group-item-action p-3">
                    <div class="fw-bold">@Localizer["Create or manage boards"]</div>
                    <div class="text-muted small">@Localizer["Plan columns, cards, priorities, labels, assignees, and due dates."]</div>
                </a>
                <a asp-controller="Kanban" asp-action="SharedWithMe" class="list-group-item list-group-item-action p-3">
                    <div class="fw-bold">@Localizer["Review shared boards"]</div>
                    <div class="text-muted small">@Localizer["Open boards shared with you through direct or role-based access."]</div>
                </a>
                <a asp-controller="Agent" asp-action="Index" class="list-group-item list-group-item-action p-3">
                    <div class="fw-bold">@Localizer["Ask the Kanban agent"]</div>
                    <div class="text-muted small">@Localizer["Get help reading and updating board state with the built-in assistant."]</div>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-xl-6">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="mb-0">@Localizer["My boards"]</h5>
            <a asp-controller="Kanban" asp-action="Index" class="btn btn-sm btn-outline-primary">
                <i class="align-middle" data-lucide="arrow-right"></i>
            </a>
        </div>
        <div class="row g-3">
            @if (Model.OwnedBoards.Any())
            {
                @foreach (var board in Model.OwnedBoards.Take(6))
                {
                    <div class="col-12 col-md-6">
                        <a asp-controller="Kanban" asp-action="Index" asp-route-boardId="@board.BoardId" class="dashboard-board p-3">
                            <div class="d-flex justify-content-between gap-3 mb-3">
                                <div class="fw-bold text-truncate">@board.Name</div>
                                @if (board.OverdueCards > 0)
                                {
                                    <span class="badge bg-danger-subtle text-danger-emphasis">@board.OverdueCards @Localizer["overdue"]</span>
                                }
                            </div>
                            <div class="dashboard-meta text-muted small">
                                <span>@board.TotalCards @Localizer["cards"]</span>
                                <span>@board.InProgressCards @Localizer["in progress"]</span>
                                <span>@board.CompletedCards @Localizer["done"]</span>
                            </div>
                        </a>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="dashboard-stat text-muted p-4 text-center">@Localizer["No boards created yet."]</div>
                </div>
            }
        </div>
    </div>

    <div class="col-12 col-xl-6">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="mb-0">@Localizer["Shared with me"]</h5>
            <a asp-controller="Kanban" asp-action="SharedWithMe" class="btn btn-sm btn-outline-primary">
                <i class="align-middle" data-lucide="arrow-right"></i>
            </a>
        </div>
        <div class="row g-3">
            @if (Model.SharedBoards.Any())
            {
                @foreach (var board in Model.SharedBoards.Take(6))
                {
                    <div class="col-12 col-md-6">
                        <a asp-controller="Kanban" asp-action="Index" asp-route-boardId="@board.BoardId" class="dashboard-board p-3">
                            <div class="d-flex justify-content-between gap-3 mb-3">
                                <div class="fw-bold text-truncate">@board.Name</div>
                                <span class="badge bg-info-subtle text-info-emphasis">@Localizer[PermissionText(board.Permission)]</span>
                            </div>
                            <div class="dashboard-meta text-muted small">
                                <span>@board.TotalCards @Localizer["cards"]</span>
                                <span>@board.IncompleteCards @Localizer["open"]</span>
                                <span>@board.CompletedCards @Localizer["done"]</span>
                            </div>
                        </a>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="dashboard-stat text-muted p-4 text-center">@Localizer["No boards are shared with you yet."]</div>
                </div>
            }
        </div>
    </div>
</div>

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
<partial name="_MarkdownReaderAssets" />
<script>
(function () {
    function renderReport(rawId, targetId) {
        var rawContent = document.getElementById(rawId);
        var target = document.getElementById(targetId);
        if (!rawContent || !target) return;

        if (window.AiursoftMarkdownUi ) {
            var rawHtml = window.AiursoftMarkdownUi.renderMarkdown(rawContent.value, { breaks: true });
            var cleanHtml = rawHtml;
            target.innerHTML = cleanHtml;
            target.classList.add('markdown-content');
            target.querySelectorAll('a[href]').forEach(function (link) {
                link.rel = 'noopener noreferrer';
                link.target = '_blank';
            });
        } else {
            target.textContent = rawContent.value;
        }
    }

    renderReport('dashboardPlanRaw', 'dashboardPlanPreview');
    renderReport('dashboardSummaryRaw', 'dashboardSummaryPreview');
})();
</script>
}
