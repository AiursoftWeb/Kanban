@model Aiursoft.Kanban.Models.KanbanViewModels.PublicBoardViewModel

@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/dist/kanban-board.css" asp-append-version="true" />
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="mb-1">@Model.Board.Name</h2>
        <span class="badge bg-secondary"><i class="align-middle" data-lucide="eye"></i> @Localizer["Read-only view"]</span>
    </div>
    @if (Model.CanEdit)
    {
        <a asp-controller="Kanban" asp-action="Index" asp-route-boardId="@Model.Board.Id" class="btn btn-primary">
            <i class="align-middle" data-lucide="edit-3"></i> @Localizer["Edit Board"]
        </a>
    }
</div>

<div class="kanban-container" id="kanban-root"></div>

<div id="loc-data" hidden>
    <span data-key="not-started">@Localizer["Not Started"]</span>
    <span data-key="in-progress">@Localizer["In Progress"]</span>
    <span data-key="completed">@Localizer["Completed"]</span>
    <span data-key="drop-cards-here">@Localizer["Drop cards here"]</span>
    <span data-key="add-card">@Localizer["Add Card"]</span>
</div>

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script type="module">
    import { KanbanBoard } from '/dist/kanban-board.js';

    KanbanBoard({
        container: '#kanban-root',
        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BoardData, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase })),
        callbacks: {}
    });

    if (typeof lucide !== 'undefined') lucide.createIcons();
    </script>
}
