<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Aiursoft.Kanban</AssemblyName>
    <RootNamespace>Aiursoft.Kanban</RootNamespace>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aiursoft.ClickhouseLoggerProvider" Version="10.0.30" />
    <PackageReference Include="Aiursoft.DbTools.Switchable" Version="10.0.32" />
    <PackageReference Include="HtmlSanitizer" Version="11.0.26" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="Aiursoft.Scanner" Version="10.0.16" />
    <PackageReference Include="Aiursoft.UiStack" Version="10.0.59" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Aiursoft.AiurProtocol.Server" Version="10.0.42" />
    <PackageReference Include="MediatR" Version="15.0.0" />
    <PackageReference Include="SkiaSharp" Version="4.157.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.157.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aiursoft.Canon.ScheduledTasks" Version="10.0.19" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Aiursoft.Kanban.InMemory\Aiursoft.Kanban.InMemory.csproj" />
    <ProjectReference Include="..\Aiursoft.Kanban.MySql\Aiursoft.Kanban.MySql.csproj" />
    <ProjectReference Include="..\Aiursoft.Kanban.Sqlite\Aiursoft.Kanban.Sqlite.csproj" />
    <ProjectReference Include="..\Aiursoft.Kanban.SDK\Aiursoft.Kanban.SDK.csproj" />
  </ItemGroup>
  <Target Name="PrepareFrontendResources" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
    <!-- Docker supplies the slimmed assets from its Node build stage. -->
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)/wwwroot" Condition="'$(SkipFrontendBuild)' != 'true'" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)/wwwroot" Condition="'$(SkipFrontendBuild)' != 'true'" />
    <Error Condition="!Exists('wwwroot/node_modules/@aiursoft/uistack/dist/css/app.css') Or !Exists('wwwroot/node_modules/@aiursoft/uistack/dist/js/app.js')" Text="The UIStack npm assets are missing. Prepare the frontend before skipping its build." />
    <ItemGroup>
      <Content Remove="wwwroot/node_modules/**/*;wwwroot/dist/**/*" />
      <Content Include="wwwroot/node_modules/**/*;wwwroot/dist/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
