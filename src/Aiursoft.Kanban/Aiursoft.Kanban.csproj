<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Aiursoft.Kanban</AssemblyName>
    <RootNamespace>Aiursoft.Kanban</RootNamespace>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aiursoft.ClickhouseLoggerProvider" Version="10.0.23" />
    <PackageReference Include="Aiursoft.DbTools.Switchable" Version="10.0.22" />
    <PackageReference Include="Aiursoft.Scanner" Version="10.0.10" />
    <PackageReference Include="Aiursoft.UiStack" Version="10.0.23" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.10" />
    <PackageReference Include="MediatR" Version="14.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.10" />
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.150.1" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aiursoft.Canon.ScheduledTasks" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Aiursoft.Kanban.InMemory\Aiursoft.Kanban.InMemory.csproj" />
    <ProjectReference Include="..\Aiursoft.Kanban.MySql\Aiursoft.Kanban.MySql.csproj" />
    <ProjectReference Include="..\Aiursoft.Kanban.Sqlite\Aiursoft.Kanban.Sqlite.csproj" />
  </ItemGroup>
</Project>
